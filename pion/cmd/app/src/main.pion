// Bunker desktop application entry point (Pion + invar Liquid Glass + Rust bunker_core).

import "corelink"
import "host"
import "hostapi"
import "lg"
import "model"
import "shell"
import "ui"
import "view"

fn drain_core(s : model::Store) -> Unit {
  while true {
    match corelink::poll_next() {
      Some(msg) => ui::answered_from_outside(fn() { s.on_message(msg) })
      None => break
    }
  }
}

fn poll_loop(root : view::View, s : model::Store) -> Unit {
  drain_core(s)
  let _ = root.at_moment(root.cause_at() + 50.0, fn() { poll_loop(root, s) }, later=true)
}

fn default_data_dir() -> String {
  let d0 = hostapi::env("BUNKER_DATA")
  if d0 != "" {
    return d0
  }
  let app = hostapi::env("APPDATA")
  if app != "" {
    return app + "\\Bunker"
  }
  hostapi::env("HOME") + "/.bunker"
}

fn main() -> Unit {
  host::install()
  lg::set_dark(Some(false))
  hostapi::window_setup(960.0, 620.0, 1200.0, 760.0, true)
  let data_dir = default_data_dir()
  let _ = corelink::init(data_dir)
  let store = model::Store::new(fn(id : Int64, j : String, b : Bytes) -> Unit {
    corelink::call(id, j, b)
  })
  store.boot(data_dir=data_dir)
  ui::run(
    "Bunker · SPT 启动器",
    fn(root : view::View) -> Unit {
      shell::bunker_app(root, store)
      poll_loop(root, store)
    },
    theme=lg::ui_theme,
  )
}
