import "hostapi"
import "signals"

// ---- String & JSON helpers ----

pub fn str_trim(s : String) -> String {
  let n = s.length()
  let mut lo = 0
  while lo < n {
    let c = s.code_unit_at(lo)
    if c == 32 || c == 9 || c == 10 || c == 13 {
      lo += 1
    } else {
      break
    }
  }
  let mut hi = n
  while hi > lo {
    let c = s.code_unit_at(hi - 1)
    if c == 32 || c == 9 || c == 10 || c == 13 {
      hi -= 1
    } else {
      break
    }
  }
  s.slice(lo, hi)
}

pub fn str_lower(s : String) -> String {
  let sb = StringBuilder::new()
  let n = s.length()
  let mut i = 0
  while i < n {
    let c = s.code_unit_at(i)
    if c >= 65 && c <= 90 {
      sb.write_byte((c + 32) as Byte)
    } else {
      sb.write_byte(c as Byte)
    }
    i += 1
  }
  sb.to_string()
}

pub fn str_contains(hay : String, needle : String) -> Bool {
  let hn = hay.length()
  let nn = needle.length()
  if nn == 0 {
    return true
  }
  if nn > hn {
    return false
  }
  let mut i = 0
  while i <= hn - nn {
    let mut ok = true
    let mut j = 0
    while j < nn {
      if hay.code_unit_at(i + j) != needle.code_unit_at(j) {
        ok = false
        break
      }
      j += 1
    }
    if ok {
      return true
    }
    i += 1
  }
  false
}

pub fn str_join(parts : Array[String], sep : String) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < parts.length() {
    if i > 0 {
      for k in 0..<sep.length() {
        sb.write_byte(sep.code_unit_at(k) as Byte)
      }
    }
    let p = parts[i]
    for k in 0..<p.length() {
      sb.write_byte(p.code_unit_at(k) as Byte)
    }
    i += 1
  }
  sb.to_string()
}

pub fn str_basename(path : String) -> String {
  let n = path.length()
  let mut last = -1
  let mut i = 0
  while i < n {
    let c = path.code_unit_at(i)
    if c == 47 || c == 92 {
      last = i
    }
    i += 1
  }
  if last >= 0 && last + 1 < n {
    path.slice(last + 1, n)
  } else {
    path
  }
}

pub fn jobj_of(pairs : Array[(String, hostapi::JsonValue)]) -> hostapi::JsonValue {
  let m : Map[String, hostapi::JsonValue] = Map::new()
  for p in pairs {
    m.set(p.0, p.1)
  }
  hostapi::JsonValue::JObject(m)
}

pub fn jget(j : hostapi::JsonValue, key : String) -> hostapi::JsonValue {
  match j {
    hostapi::JsonValue::JObject(m) =>
      match m.get(key) {
        Some(v) => v
        None => hostapi::JsonValue::JNull
      }
    _ => hostapi::JsonValue::JNull
  }
}

pub fn jstr(j : hostapi::JsonValue, key : String) -> String {
  match jget(j, key) {
    hostapi::JsonValue::JString(s) => s
    _ => ""
  }
}

pub fn jnum(j : hostapi::JsonValue, key : String) -> Double {
  match jget(j, key) {
    hostapi::JsonValue::JNumber(n) => n
    _ => 0.0
  }
}

pub fn jint(j : hostapi::JsonValue, key : String) -> Int {
  jnum(j, key).to_int()
}

pub fn jbool(j : hostapi::JsonValue, key : String) -> Bool {
  match jget(j, key) {
    hostapi::JsonValue::JBool(b) => b
    _ => false
  }
}

pub fn jarr(j : hostapi::JsonValue, key : String) -> Array[hostapi::JsonValue] {
  match jget(j, key) {
    hostapi::JsonValue::JArray(a) => a
    _ => []
  }
}

pub fn jstrings(xs : Array[hostapi::JsonValue]) -> Array[String] {
  let out : Array[String] = []
  for x in xs {
    match x {
      hostapi::JsonValue::JString(s) => out.push(s)
      _ => ()
    }
  }
  out
}

// ---- Domain types ----

#derive(Eq)
pub enum Page {
  Play
  Mods
  Snapshots
  Config
}

pub fn page_index(p : Page) -> Int {
  match p {
    Page::Play => 0
    Page::Mods => 1
    Page::Snapshots => 2
    Page::Config => 3
  }
}

pub fn page_from_index(i : Int) -> Page {
  if i == 1 {
    Page::Mods
  } else if i == 2 {
    Page::Snapshots
  } else if i == 3 {
    Page::Config
  } else {
    Page::Play
  }
}

pub struct Inst {
  pub root : String
  pub name : String
  pub layout : String
  pub spt_version : String
  pub eft_version : String
  pub server_mods_dir : String
  pub client_plugins_dir : String
  pub profiles_dir : String
  pub server_exe : String
  pub client_exe : String
  pub valid : Bool
  pub problems : Array[String]
}

pub fn Inst::from_json(j : hostapi::JsonValue) -> Inst {
  Inst::{
    root: jstr(j, "root"),
    name: jstr(j, "name"),
    layout: jstr(j, "layout"),
    spt_version: jstr(j, "spt_version"),
    eft_version: jstr(j, "eft_version"),
    server_mods_dir: jstr(j, "server_mods_dir"),
    client_plugins_dir: jstr(j, "client_plugins_dir"),
    profiles_dir: jstr(j, "profiles_dir"),
    server_exe: jstr(j, "server_exe"),
    client_exe: jstr(j, "client_exe"),
    valid: jbool(j, "valid"),
    problems: jstrings(jarr(j, "problems")),
  }
}

pub struct BadDll {
  pub path : String
  pub shown : String
  pub built_for : String
}

pub struct ModRef {
  pub id : String
  pub name : String
}

pub struct ModItem {
  pub id : String
  pub name : String
  pub author : String
  pub version : String
  pub side : String
  pub enabled : Bool
  pub managed : Bool
  pub roots : Array[String]
  pub loc_en : Int
  pub loc_ch : Int
  pub source_kind : String
  pub source_url : String
  pub compat : String
  pub spt_range : String
  pub update : String
  pub dll_status : String
  pub built_for : String
  pub bad_dlls : Array[BadDll]
  pub required_by : Array[ModRef]
  pub requires : Array[ModRef]
  pub fix_url : String
}

pub fn ModItem::incompatible(self : ModItem) -> Bool {
  self.enabled && self.dll_status == "incompatible"
}

pub fn ModItem::needed_by(self : ModItem) -> String {
  let names : Array[String] = []
  for r in self.required_by {
    names.push(r.name)
  }
  str_join(names, "、")
}

pub fn ModItem::with_enabled(self : ModItem, on : Bool) -> ModItem {
  ModItem::{
    id: self.id,
    name: self.name,
    author: self.author,
    version: self.version,
    side: self.side,
    enabled: on,
    managed: self.managed,
    roots: self.roots,
    loc_en: self.loc_en,
    loc_ch: self.loc_ch,
    source_kind: self.source_kind,
    source_url: self.source_url,
    compat: self.compat,
    spt_range: self.spt_range,
    update: self.update,
    dll_status: self.dll_status,
    built_for: self.built_for,
    bad_dlls: self.bad_dlls,
    required_by: self.required_by,
    requires: self.requires,
    fix_url: self.fix_url,
  }
}

pub fn ModItem::with_update(self : ModItem, latest : String) -> ModItem {
  ModItem::{
    id: self.id,
    name: self.name,
    author: self.author,
    version: self.version,
    side: self.side,
    enabled: self.enabled,
    managed: self.managed,
    roots: self.roots,
    loc_en: self.loc_en,
    loc_ch: self.loc_ch,
    source_kind: self.source_kind,
    source_url: self.source_url,
    compat: self.compat,
    spt_range: self.spt_range,
    update: latest,
    dll_status: self.dll_status,
    built_for: self.built_for,
    bad_dlls: self.bad_dlls,
    required_by: self.required_by,
    requires: self.requires,
    fix_url: self.fix_url,
  }
}

pub fn ModItem::from_json(j : hostapi::JsonValue) -> ModItem {
  let loc = jget(j, "locale")
  let bad_dlls : Array[BadDll] = []
  for b in jarr(j, "bad_dlls") {
    bad_dlls.push(BadDll::{
      path: jstr(b, "path"),
      shown: jstr(b, "shown"),
      built_for: jstr(b, "built_for"),
    })
  }
  let required_by : Array[ModRef] = []
  for r in jarr(j, "required_by") {
    required_by.push(ModRef::{ id: jstr(r, "id"), name: jstr(r, "name") })
  }
  let requires : Array[ModRef] = []
  for r in jarr(j, "requires") {
    requires.push(ModRef::{ id: jstr(r, "id"), name: jstr(r, "name") })
  }
  ModItem::{
    id: jstr(j, "id"),
    name: jstr(j, "name"),
    author: jstr(j, "author"),
    version: jstr(j, "version"),
    side: jstr(j, "side"),
    enabled: jbool(j, "enabled"),
    managed: jbool(j, "managed"),
    roots: jstrings(jarr(j, "roots")),
    loc_en: jint(loc, "en"),
    loc_ch: jint(loc, "ch"),
    source_kind: jstr(j, "source_kind"),
    source_url: jstr(j, "source_url"),
    compat: jstr(j, "compat"),
    spt_range: jstr(j, "spt_range"),
    update: "",
    dll_status: jstr(j, "dll_status"),
    built_for: jstr(j, "built_for"),
    bad_dlls,
    required_by,
    requires,
    fix_url: jstr(j, "fix_url"),
  }
}

pub struct Snap {
  pub id : String
  pub note : String
  pub kind : String
  pub created_at : Double
  pub files : Int
  pub bytes : Double
  pub characters : Array[String]
}

pub fn Snap::from_json(j : hostapi::JsonValue) -> Snap {
  Snap::{
    id: jstr(j, "id"),
    note: jstr(j, "note"),
    kind: jstr(j, "kind"),
    created_at: jnum(j, "created_at"),
    files: jarr(j, "files").length(),
    bytes: jnum(j, "bytes"),
    characters: jstrings(jarr(j, "characters")),
  }
}

pub struct Character {
  pub profile_id : String
  pub username : String
  pub nickname : String
  pub side : String
  pub edition : String
  pub level : Int
  pub roubles : Double
  pub started : Bool
}

pub fn Character::from_json(j : hostapi::JsonValue) -> Character {
  Character::{
    profile_id: jstr(j, "profile_id"),
    username: jstr(j, "username"),
    nickname: jstr(j, "nickname"),
    side: jstr(j, "side"),
    edition: jstr(j, "edition"),
    level: jint(j, "level"),
    roubles: jnum(j, "roubles"),
    started: jbool(j, "started"),
  }
}

pub fn Character::shown(self : Character) -> String {
  if self.nickname == "" {
    self.username
  } else {
    self.nickname
  }
}

