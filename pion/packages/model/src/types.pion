pub struct PlanMapping {
  pub from : String
  pub to : String
  pub side : String
  pub files : Int
}

pub struct Plan {
  pub id : String
  pub archive : String
  pub name : String
  pub version : String
  pub target : String
  pub replaces : String
  pub adapted : Bool
  pub mappings : Array[PlanMapping]
  pub conflicts : Array[String]
  pub skipped : Array[String]
  pub warnings : Array[String]
  pub files : Int
}

pub fn Plan::from_json(j : hostapi::JsonValue) -> Plan {
  let mappings : Array[PlanMapping] = []
  for m in jarr(j, "mappings") {
    mappings.push(PlanMapping::{
      from: jstr(m, "from"),
      to: jstr(m, "to"),
      side: jstr(m, "side"),
      files: jint(m, "files"),
    })
  }
  let conflicts : Array[String] = []
  for c in jarr(j, "conflicts") {
    conflicts.push(jstr(c, "path"))
  }
  Plan::{
    id: jstr(j, "id"),
    archive: jstr(j, "archive"),
    name: jstr(j, "name"),
    version: jstr(j, "version"),
    target: jstr(j, "target"),
    replaces: jstr(j, "replaces"),
    adapted: jbool(j, "adapted"),
    mappings,
    conflicts,
    skipped: jstrings(jarr(j, "skipped")),
    warnings: jstrings(jarr(j, "warnings")),
    files: jint(j, "files"),
  }
}

pub struct Toast {
  pub text : String
  pub bad : Bool
}

// ---- Formatting helpers ----

pub fn roubles_text(r : Double) -> String {
  if r >= 1000000.0 {
    let tenths = (r / 100000.0).to_int()
    "\{tenths / 10}.\{tenths % 10}M ₽"
  } else if r >= 1000.0 {
    "\{(r / 1000.0).to_int()}K ₽"
  } else {
    "\{r.to_int()} ₽"
  }
}

pub fn count_text(n : Int) -> String {
  let s = n.to_string()
  let sb = StringBuilder::new()
  let len = s.length()
  let mut i = 0
  while i < len {
    if i > 0 && (len - i) % 3 == 0 {
      sb.write_byte(44 as Byte)
    }
    sb.write_byte(s.code_unit_at(i) as Byte)
    i += 1
  }
  sb.to_string()
}

pub fn moment_text(ms : Double, offset_min : Int) -> String {
  let secs = (ms / 1000.0).to_int64() + offset_min.to_int64() * 60L
  let days = if secs >= 0L { secs / 86400L } else { (secs - 86399L) / 86400L }
  let t = secs - days * 86400L
  let z = days + 719468L
  let era = (if z >= 0L { z } else { z - 146096L }) / 146097L
  let doe = z - era * 146097L
  let yoe = (doe - doe / 1460L + doe / 36524L - doe / 146096L) / 365L
  let doy = doe - (365L * yoe + yoe / 4L - yoe / 100L)
  let mp = (5L * doy + 2L) / 153L
  let d = doy - (153L * mp + 2L) / 5L + 1L
  let m = if mp < 10L { mp + 3L } else { mp - 9L }
  let two = fn(x : Int64) -> String { if x < 10L { "0\{x}" } else { x.to_string() } }
  "\{two(m)}-\{two(d)} \{two(t / 3600L)}:\{two(t / 60L % 60L)}"
}

pub fn bytes_text(b : Double) -> String {
  if b >= 1048576.0 {
    let tenths = (b / 104857.6).to_int()
    "\{tenths / 10}.\{tenths % 10} MB"
  } else if b >= 1024.0 {
    "\{(b / 1024.0).to_int()} KB"
  } else {
    "\{b.to_int()} B"
  }
}

pub fn dependents_of(list : Array[ModItem]) -> Array[ModRef] {
  let out : Array[ModRef] = []
  for m in list {
    for r in m.required_by {
      let mut in_list = false
      for x in list {
        if x.id == r.id {
          in_list = true
          break
        }
      }
      let mut in_out = false
      for x in out {
        if x.id == r.id {
          in_out = true
          break
        }
      }
      if !in_list && !in_out {
        out.push(r)
      }
    }
  }
  out
}

// ---- signals::Eq implementations ----

impl signals::Eq for Page {
  fn eq(self : Page, other : Page) -> Bool {
    page_index(self) == page_index(other)
  }
}

impl signals::Eq for Inst {
  fn eq(self : Inst, other : Inst) -> Bool {
    self.root == other.root && self.name == other.name && self.spt_version == other.spt_version && self.valid == other.valid
  }
}

impl signals::Eq for ModItem {
  fn eq(self : ModItem, other : ModItem) -> Bool {
    self.id == other.id &&
    self.name == other.name &&
    self.version == other.version &&
    self.enabled == other.enabled &&
    self.update == other.update &&
    self.dll_status == other.dll_status &&
    self.compat == other.compat
  }
}

impl signals::Eq for Snap {
  fn eq(self : Snap, other : Snap) -> Bool {
    self.id == other.id && self.note == other.note && self.files == other.files
  }
}

impl signals::Eq for Character {
  fn eq(self : Character, other : Character) -> Bool {
    self.username == other.username && self.nickname == other.nickname && self.level == other.level && self.roubles == other.roubles
  }
}

impl signals::Eq for ServerStatus {
  fn eq(self : ServerStatus, other : ServerStatus) -> Bool {
    self.state == other.state &&
    self.pid == other.pid &&
    self.port == other.port &&
    self.warns == other.warns &&
    self.errors == other.errors &&
    self.message == other.message
  }
}

impl signals::Eq for LogLine {
  fn eq(self : LogLine, other : LogLine) -> Bool {
    self.n == other.n && self.level == other.level && self.text == other.text
  }
}

impl signals::Eq for ConfigFile {
  fn eq(self : ConfigFile, other : ConfigFile) -> Bool {
    self.path == other.path && self.bytes == other.bytes
  }
}

impl signals::Eq for PlanMapping {
  fn eq(self : PlanMapping, other : PlanMapping) -> Bool {
    self.from == other.from && self.to == other.to && self.files == other.files
  }
}

impl signals::Eq for Plan {
  fn eq(self : Plan, other : Plan) -> Bool {
    self.id == other.id && self.archive == other.archive && self.files == other.files
  }
}

impl signals::Eq for Toast {
  fn eq(self : Toast, other : Toast) -> Bool {
    self.text == other.text && self.bad == other.bad
  }
}
