// The Snapshots page (a solid "new snapshot" card over the snapshot history) and the Config page (a scrolling
// solid file list beside an editor card with live syntax check, undo and save).

import "icons"
import "lg"
import "model"
import "signals"
import "ui"
import "view"

fn snap_kind_label(k : String) -> String {
  if k == "manual" {
    "手动备份"
  } else if k == "before_install" {
    "装 Mod 前"
  } else if k == "before_restore" {
    "回滚前"
  } else {
    k
  }
}

pub fn snapshots_page(pg : view::View, s : model::Store, back : () -> Unit) -> Unit {
  let note = ui::Field::new()
  let take = fn() {
    let t = note.text()
    s.snapshot(if model::str_trim(t) == "" { "手动备份" } else { t })
    note.set("")
  }
  <lg::PageShell
    in={pg}
    top_edge_blur={true}
    leading={fn(l : view::View) -> Unit { <PageTitle in={l} title="存档快照" on_back={back} /> }}
    trailing={fn(tr : view::View) -> Unit { <WindowPills in={tr} /> }}
  >
    <ui::Col pad_x={24.0} gap={20.0}>
      <ui::Row align={.Middle} gap={10.0}>
        <ui::Box
          grow={1.0}
          min_width={0.0}
          ref_view={fn(v : view::View) {
            let _ = lg::liquid_text_field_node(
              v,
              note,
              placeholder="新快照的备注，例如：实验室撤离前、更新 Mod 前",
              label=fn() { "快照备注" },
              flat=true,
              show_label=false,
              clearable=true,
              submitted=fn(_t : String) -> Unit { take() },
            )
          }}
        />
        <lg::Button flat prominent height={36.0} pad_x={16.0} label="立即备份" on_press=>{take()} />
      </ui::Row>
      <lg::SurfaceSection header="快照历史" footer_by=>{"共 \{s.snapshots.get().length()} 份 · 回滚前会先自动备份当前存档；服务端运行时不能回滚"}>
        <ui::Box
          ref_view={fn(list : view::View) {
            list.show(fn() { s.snapshots.get().length() == 0 }, at_once=true, fn(empty : view::View) -> Unit {
              <SectionRow in={empty}>
                <Label text="还没有存档快照。" size={14.0} secondary />
              </SectionRow>
            })
            list.each(
              fn() { s.snapshots.get() },
              fn(sn : model::Snap) -> String { sn.id },
              fn(slot : view::View, sn : signals::Signal[model::Snap]) -> Unit {
                slot.show(
                  fn() {
                    let all = s.snapshots.get()
                    all.length() > 0 && all[0].id != sn.get().id
                  },
                  at_once=true,
                  fn(d : view::View) -> Unit { <Divider in={d} /> },
                )
                snap_row(slot, s, sn)
              },
            )
          }}
        />
      </lg::SurfaceSection>
      <ui::Spacer height={24.0} />
    </ui::Col>
  </lg::PageShell>
}

fn snap_row(parent : view::View, s : model::Store, sn : signals::Signal[model::Snap]) -> Unit {
  let confirm = signals::signal(false)
  <SectionRow in={parent}>
    <ui::Col width={0.0} grow={1.0} min_width={0.0} gap={4.0}>
      <ui::Row align={.Middle} gap={8.0} wrap line_gap={4.0}>
        <icons::Icon name="archive" size={18.0} color_by=>{accent()} />
        <Label text_by=>{if sn.get().note != "" { sn.get().note } else { sn.get().id }} size={14.5} weight={600} />
        <lg::Badge label_by=>{snap_kind_label(sn.get().kind)} tone={.Accent} />
      </ui::Row>
      <Label
        text_by=>{
          let cur = sn.get()
          "\{model::moment_text(cur.created_at, s.tz_offset_min)} · \{cur.files} 个文件（\{model::bytes_text(cur.bytes)}） · \{model::str_join(cur.characters, "、")}"
        }
        size={12.5}
        secondary
        wrap
        pad_left={26.0}
      />
    </ui::Col>
    <ui::Box
      ref_view={fn(v : view::View) {
        let _ = v.row(view::Live::Is(true)).gap(view::Live::Is(6.0))
        v.pick(fn() { confirm.get() }, at_once=true, fn(a : view::View, sure : Bool) -> Unit {
          if sure {
            <lg::Button
              in={a}
              flat
              prominent
              height={btn_h}
              pad_x={10.0}
              label="确认回滚"
              on_press=>{
                confirm.set(false)
                s.restore(sn.untracked().id)
              }
            />
          } else {
            <lg::Button in={a} flat height={btn_h} pad_x={10.0} label="回滚" on_press=>{confirm.set(true)} />
          }
        })
        <lg::Button in={v} flat height={btn_h} pad_x={10.0} label="删除" on_press=>{s.delete_snapshot(sn.untracked().id)} />
      }}
    />
  </SectionRow>
}

pub fn config_page(pg : view::View, s : model::Store, back : () -> Unit) -> Unit {
  let editor = ui::Field::new()
  let dirty = signals::signal(false)
  <lg::PageShell
    in={pg}
    top_edge_blur={true}
    leading={fn(l : view::View) -> Unit { <PageTitle in={l} title="配置文件" on_back={back} /> }}
    trailing={fn(tr : view::View) -> Unit { <WindowPills in={tr} /> }}
  >
    <ui::Box
      ref_view={fn(split : view::View) {
        // The two panes fill the window under the top bar (60pt) with a 24pt foot, not the page's scroll.
        let _ = split
          .padding(view::Live::Is((24.0, 0.0, 24.0, 24.0)))
          .height(view::Live::By(fn() { Some(ui::dmax(420.0, split.window_h() - 60.0)) }))
        split.reacts(fn() { s.config_text.get() }, fn(txt : String) -> Unit {
          editor.set(txt)
          dirty.set(false)
        })
        // One solid surface: the file list and the editor side by side, a 0.5pt hairline between them.
        let _ = split.box(fn(pane : view::View) -> Unit {
        let _ = pane
          .fill()
          .row(view::Live::Is(true))
          .radius(view::Live::Is(card_r))
          .ground(view::Live::By(fn() { lg::surface().card }))
          .edge(view::Live::By(fn() { (lg::hairline_w, lg::surface().separator) }))
          .clips(view::Live::Is(true))
        let _ = pane.box(fn(left : view::View) -> Unit {
          let _ = left
            .width(view::Live::By(fn() { Some(if is_narrow(left) { 230.0 } else { 270.0 }) }))
            .shrink(view::Live::Is(0.0))
            .min_height(view::Live::Is(Some(0.0)))
          let _ = ui::scroll_box(left, fn(c : view::View) -> Unit {
            <ui::Col in={c} pad={10.0} gap={2.0}>
              <Label text_by=>{"配置文件 · \{s.configs.get().length()}"} size={12.0} weight={600} secondary pad_left={10.0} />
              <ui::Spacer height={4.0} />
            </ui::Col>
            let _ = c.box(fn(list : view::View) -> Unit {
              let _ = list.padding(view::Live::Is((10.0, 0.0, 10.0, 10.0))).gap(view::Live::Is(2.0))
              list.each(
                fn() { s.configs.get() },
                fn(cf : model::ConfigFile) -> String { cf.path },
                fn(slot : view::View, cf : signals::Signal[model::ConfigFile]) -> Unit {
                  <PlainRow
                    in={slot}
                    title_by=>{model::str_basename(cf.get().path)}
                    subtitle_by=>{"\{cf.get().owner} · \{model::bytes_text(cf.get().bytes)}"}
                    active_by=>{s.config_path.get() == cf.get().path}
                    on_press=>{s.open_config(cf.untracked().path)}
                  />
                },
              )
            })
          })
        })
        let _ = pane.box(fn(sep : view::View) -> Unit {
          let _ = sep
            .width(view::Live::Is(Some(lg::hairline_w)))
            .height_share(view::Live::Is(1.0))
            .shrink(view::Live::Is(0.0))
            .ground(view::Live::By(fn() { lg::surface().separator }))
        })
        let _ = pane.box(fn(right : view::View) -> Unit {
          let _ = right.fill().padding(view::Live::Is((card_pad, card_pad, card_pad, card_pad))).gap(view::Live::Is(12.0))
          let c = right
          {
            <ui::Row in={c} align={.Middle} gap={8.0}>
              <ui::Col width={0.0} grow={1.0} min_width={0.0} gap={2.0}>
                <Label
                  text_by=>{
                    let p = s.config_path.get()
                    if p != "" { model::str_basename(p) } else { "配置编辑器" }
                  }
                  size={15.0}
                  weight={600}
                />
                <Label
                  text_by=>{
                    let p = s.config_path.get()
                    if p != "" { p } else { "从左侧选择一个配置文件" }
                  }
                  size={12.0}
                  secondary
                  lines={1}
                />
              </ui::Col>
              <ui::Show when=>{dirty.get()} at_once>
                <lg::Badge label="未保存" tone={.Warning} dot />
              </ui::Show>
            </ui::Row>
            <ui::Box
              in={c}
              ref_view={fn(well : view::View) {
                let _ = well
                  .grow(view::Live::Is(1.0))
                  .basis(view::Live::Is(Some(0.0)))
                  .min_height(view::Live::Is(Some(160.0)))
                  .radius(view::Live::Is(lg::r_row))
                  .ground(view::Live::By(fn() { lg::surface().code_bg }))
                  .edge(view::Live::By(fn() { (lg::hairline_w, lg::surface().separator) }))
                  .padding(view::Live::Is((14.0, 12.0, 14.0, 12.0)))
                  .clips(view::Live::Is(true))
                well.reacts(fn() { lg::is_dark() }, fn(_d : Bool) -> Unit {
                  editor.color = lg::surface().ink
                  editor.ph_color = lg::surface().ink_secondary
                  editor.caret_color = lg::surface().accent
                })
                let ed = ui::field(
                  well,
                  editor,
                  placeholder="选择配置文件后在这里编辑 JSON / JSONC / CFG",
                  font_size=13.0,
                  max_lines=0,
                  enter_sends=false,
                  label="配置内容",
                  edited=fn(t : String) -> Unit {
                    dirty.set(t != s.config_text.untracked())
                    s.check_config(t)
                  },
                  color=lg::surface().ink,
                  placeholder_color=lg::surface().ink_secondary,
                  caret_color=lg::surface().accent,
                )
                let _ = ed.grow(view::Live::Is(1.0))
              }}
            />
            <ui::Row in={c} align={.Middle} gap={8.0}>
              <Label
                text_by=>{
                  let chk = s.config_check.get()
                  if chk == "" {
                    "保存时自动校验语法，并把原文件留作 .bak"
                  } else if chk == "ok" {
                    "语法校验通过"
                  } else {
                    chk
                  }
                }
                size={12.5}
                color_by=>{
                  let chk = s.config_check.get()
                  if chk == "ok" {
                    lg::surface().positive
                  } else if chk == "" {
                    ink2()
                  } else {
                    lg::surface().danger
                  }
                }
                wrap
              />
              <lg::Button
                flat
                height={btn_h}
                pad_x={12.0}
                label="撤销修改"
                disabled_by=>{!dirty.get()}
                on_press=>{
                  editor.set(s.config_text.untracked())
                  dirty.set(false)
                  s.config_check.set("")
                }
              />
              <lg::Button
                flat
                prominent
                height={btn_h}
                pad_x={12.0}
                label="校验并保存"
                disabled_by=>{s.config_path.get() == "" || !dirty.get()}
                on_press=>{s.save_config(editor.text())}
              />
            </ui::Row>
          }
        })
        })
      }}
    />
  </lg::PageShell>
}
