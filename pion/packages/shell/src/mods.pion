// The Mods page: a floating search + filter bar over one solid section of mod rows (flat actions only), and the
// install popover in the top bar (step 1 pick an archive or paste a link ↔ step 2 review the plan and install).

import "headless"
import "hostapi"
import "lg"
import "model"
import "signals"
import "ui"
import "view"

fn side_label(side : String) -> String {
  if side == "client" {
    "客户端"
  } else if side == "server" {
    "服务端"
  } else if side == "both" {
    "双端"
  } else {
    side
  }
}

let filter_keys : Array[String] = ["all", "on", "off", "update", "bad"]

fn filter_index(key : String) -> Int {
  let mut i = 0
  while i < filter_keys.length() {
    if filter_keys[i] == key {
      return i
    }
    i += 1
  }
  0
}

pub fn mods_page(pg : view::View, root : view::View, s : model::Store, back : () -> Unit) -> Unit {
  let search = ui::Field::new()
  <lg::PageShell
    in={pg}
    top_edge_blur={true}
    leading={fn(l : view::View) -> Unit { <PageTitle in={l} title="Mod 管理" on_back={back} /> }}
    trailing={fn(tr : view::View) -> Unit {
      <lg::BarPillGroup in={tr} height={pill_h} label="Mod 操作">
        <IconAction icon="refresh" label="检查更新" on_press=>{s.check_updates()} disabled_by=>{s.busy.get() != ""} />
      </lg::BarPillGroup>
      <WindowPills in={tr} />
    }}
  >
    <ui::Col pad_x={24.0} gap={16.0}>
      <ui::Row align={.Middle} gap={10.0}>
        <ui::Box
          grow={1.0}
          min_width={0.0}
          ref_view={fn(v : view::View) {
            let _ = lg::liquid_search_bar_node(
              v,
              search,
              placeholder="搜索 Mod 名称、作者或目录",
              label=fn() { "搜索 Mod" },
              edited=fn(q : String) -> Unit { s.mods_query.set(q) },
              on_clear=fn() -> Unit { s.mods_query.set("") },
            )
          }}
        />
        <lg::Segmented
          labels={["全部", "已启用", "已禁用", "有更新", "不兼容"]}
          selected_by=>{filter_index(s.mods_filter.get())}
          on_select={fn(i : Int) -> Unit { s.mods_filter.set(filter_keys[i]) }}
        />
        <InstallPicker root={root} s={s} />
      </ui::Row>
      <lg::SurfaceSection
        header="已安装 Mod"
        footer_by=>{"显示 \{s.mods_shown().length()} / 共 \{s.mods.get().length()} 个 · 禁用的 Mod 暂存在 .bunker/disabled"}
      >
        <ui::Box
          ref_view={fn(list : view::View) {
            list.show(fn() { s.mods_shown().length() == 0 }, at_once=true, fn(empty : view::View) -> Unit {
              <SectionRow in={empty}>
                <Label text="没有匹配的 Mod。" size={14.0} secondary />
              </SectionRow>
            })
            list.each(
              fn() { s.mods_shown() },
              fn(m : model::ModItem) -> String { m.id },
              fn(slot : view::View, m : signals::Signal[model::ModItem]) -> Unit {
                slot.show(
                  fn() {
                    let shown = s.mods_shown()
                    shown.length() > 0 && shown[0].id != m.get().id
                  },
                  at_once=true,
                  fn(d : view::View) -> Unit { <Divider in={d} /> },
                )
                mod_row(slot, s, m)
              },
            )
          }}
        />
      </lg::SurfaceSection>
      <ui::Spacer height={24.0} />
    </ui::Col>
  </lg::PageShell>
}

fn open_mod_config(s : model::Store, m : model::ModItem) -> Unit {
  let owners : Array[String] = []
  for rt in m.roots {
    owners.push(model::str_basename(rt))
  }
  for cf in s.configs.untracked() {
    for ow in owners {
      if cf.owner == ow {
        s.page.set(.Config)
        s.open_config(cf.path)
        return
      }
    }
  }
  s.say("这个 Mod 没有可编辑的配置文件（JSON / JSONC / CFG）")
}

fn mod_row(parent : view::View, s : model::Store, m : signals::Signal[model::ModItem]) -> Unit {
  let confirm = signals::signal(false)
  let asking = signals::signal(false)
  <SectionRow in={parent}>
    <lg::Toggle
      label_by=>{"启用 \{m.get().name}"}
      on_by=>{m.get().enabled}
      on_change={fn(on : Bool) -> Unit { s.set_mod_enabled(m.untracked().id, on) }}
    />
    <ui::Col width={0.0} grow={1.0} min_width={0.0} gap={4.0}>
      <ui::Row align={.Middle} gap={8.0} wrap line_gap={4.0}>
        <Label text_by=>{m.get().name} size={14.5} weight={600} />
        <Label text_by=>{if m.get().version != "" { "v\{m.get().version}" } else { "" }} size={12.0} secondary />
        <Label text_by=>{if m.get().author != "" { m.get().author } else { "" }} size={12.0} secondary />
        <lg::Badge label_by=>{side_label(m.get().side)} tone={.Neutral} />
        <ui::Show when=>{m.get().update != ""} at_once>
          <lg::Badge label_by=>{"可升级 v\{m.get().update}"} tone={.Accent} dot />
        </ui::Show>
        <ui::Show when=>{m.get().incompatible()} at_once>
          <lg::Badge label="不兼容" tone={.Danger} dot />
        </ui::Show>
        <ui::Show when=>{m.get().loc_ch > 0} at_once>
          <lg::Badge label_by=>{"汉化 \{m.get().loc_ch}"} tone={.Success} />
        </ui::Show>
      </ui::Row>
      <Label
        text_by=>{
          let cur = m.get()
          if cur.roots.length() > 0 { cur.roots[0] } else { cur.id }
        }
        size={12.0}
        secondary
        lines={1}
      />
    </ui::Col>
    <ui::Box
      ref_view={fn(v : view::View) {
        v.pick(
          fn() -> Int { if asking.get() { 2 } else if m.get().incompatible() { 1 } else { 0 } },
          at_once=true,
          fn(act : view::View, kind : Int) -> Unit {
            let _ = act.row(view::Live::Is(true)).gap(view::Live::Is(6.0)).lines_up(view::Live::Is(Some(view::Along::Middle)))
            if kind == 2 {
              <lg::Button in={act} flat height={btn_h} pad_x={10.0} label="取消" on_press=>{asking.set(false)} />
              <lg::Button
                in={act}
                flat
                height={btn_h}
                pad_x={10.0}
                label="仅禁用"
                on_press=>{
                  asking.set(false)
                  s.disable_mods([m.untracked().id], false)
                }
              />
              <lg::Button
                in={act}
                flat
                tint={lg::surface().danger}
                height={btn_h}
                pad_x={10.0}
                label="连同依赖"
                on_press=>{
                  asking.set(false)
                  s.disable_mods([m.untracked().id], true)
                }
              />
            } else if kind == 1 {
              act.show(fn() { m.get().fix_url != "" }, at_once=true, fn(y : view::View) -> Unit {
                <lg::Button in={y} flat prominent height={btn_h} pad_x={10.0} label="一键更新" on_press=>{s.fix_mods([m.untracked().id])} />
              })
              <lg::Button
                in={act}
                flat
                height={btn_h}
                pad_x={10.0}
                label="禁用"
                on_press=>{
                  if m.untracked().required_by.length() == 0 {
                    s.disable_mods([m.untracked().id], false)
                  } else {
                    asking.set(true)
                  }
                }
              />
            } else {
              act.show(fn() { m.get().update != "" }, at_once=true, fn(y : view::View) -> Unit {
                <lg::Button in={y} flat prominent height={btn_h} pad_x={10.0} label="更新" on_press=>{s.update_mod(m.untracked().id)} />
              })
              <lg::Button in={act} flat height={btn_h} pad_x={10.0} label="配置" on_press=>{open_mod_config(s, m.untracked())} />
              act.pick(fn() { confirm.get() }, at_once=true, fn(u : view::View, sure : Bool) -> Unit {
                if sure {
                  <lg::Button
                    in={u}
                    flat
                    tint={lg::surface().danger}
                    height={btn_h}
                    pad_x={10.0}
                    label="确认卸载"
                    on_press=>{
                      confirm.set(false)
                      s.uninstall(m.untracked().id)
                    }
                  />
                } else {
                  <lg::Button in={u} flat height={btn_h} pad_x={10.0} label="卸载" on_press=>{confirm.set(true)} />
                }
              })
            }
          },
        )
      }}
    />
  </SectionRow>
}

/// The top bar's install button and its popover (step 1 ↔ step 2 in place).
fn InstallPicker(parent : view::View, root~ : view::View, s~ : model::Store) -> view::View {
  lg::liquid_popover_node(
    parent,
    root,
    fn() { s.install_open.get() },
    fn(v : Bool) -> Unit {
      s.install_open.set(v)
      if !v {
        s.drop_plan()
      }
    },
    fn() { "安装 Mod" },
    fn(trig : view::View, _d : headless::Disclosure) -> Unit {
      <lg::Button
        in={trig}
        prominent
        height={36.0}
        pad_x={14.0}
        label="安装 Mod"
        on_press=>{s.install_open.set(!s.install_open.untracked())}
      />
    },
    fn() { "安装新 Mod" },
    fn(pop : view::View) -> Unit { install_popover_body(pop, s) },
    placement=.BelowEnd,
    width=440.0,
    radius=pop_r,
    pad=pop_pad,
  )
}

fn no_plan() -> model::Plan {
  model::Plan::{
    id: "",
    archive: "",
    name: "",
    version: "",
    target: "",
    replaces: "",
    adapted: false,
    mappings: [],
    conflicts: [],
    skipped: [],
    warnings: [],
    files: 0,
  }
}

fn pick_archive(s : model::Store) -> Unit {
  match hostapi::pick(.Files, false) {
    Some(pk) =>
      match pk.files() {
        Some(files) => if files.length() > 0 { s.plan_bytes(files[0].name, files[0].bytes) }
        None => ()
      }
    None => ()
  }
}

pub fn install_popover_body(pop : view::View, s : model::Store) -> Unit {
  let url_field = ui::Field::new()
  let _ = pop.gap(view::Live::Is(10.0))
  pop.pick(fn() { s.install_step.get() }, at_once=true, fn(body : view::View, step : Int) -> Unit {
    let _ = body.gap(view::Live::Is(14.0))
    if step == 1 {
      <ui::Row in={body} rigid align={.Middle} gap={8.0} pad_x={4.0}>
        <Label text="安装新 Mod" size={15.0} weight={700} grow />
        <lg::Badge label="步骤 1 / 2" tone={.Accent} />
      </ui::Row>
      let _ = lg::liquid_list_node(
        body,
        fn() {
          [
            lg::LiquidListRow::new(
              title=if s.busy.get() == "planning" { "正在分析压缩包…" } else { "选择本地压缩包" },
              subtitle=".zip / .7z，先出安装计划，确认后才写入",
              chevron=true,
              disabled=s.busy.get() == "planning",
              on_press=fn() { pick_archive(s) },
            ),
          ]
        },
        flat=true,
      )
      let _ = lg::liquid_text_field_node(
        body,
        url_field,
        placeholder="或粘贴 GitHub Releases 链接",
        label=fn() { "Mod 链接" },
        flat=true,
        show_label=false,
        submitted=fn(t : String) -> Unit { s.plan_url(t) },
      )
      <ui::Row in={body} rigid align={.Middle} gap={8.0}>
        <Label text="安装前会自动快照存档" size={12.0} secondary grow />
        <lg::Button
          flat
          prominent
          height={btn_h}
          pad_x={14.0}
          label="解析链接"
          on_press=>{s.plan_url(url_field.text())}
          disabled_by=>{s.busy.get() == "planning"}
        />
      </ui::Row>
    } else {
      let plan = fn() -> model::Plan {
        match s.plan.get() {
          Some(p) => p
          None => no_plan()
        }
      }
      <ui::Row in={body} rigid align={.Middle} gap={8.0} pad_x={4.0}>
        <Label text_by=>{"\{plan().name} \{plan().version}"} size={15.0} weight={700} grow />
        <lg::Badge label="步骤 2 / 2" tone={.Accent} />
      </ui::Row>
      <ui::Row in={body} rigid align={.Middle} gap={8.0} pad_x={4.0} wrap line_gap={4.0}>
        <Label text_by=>{plan().archive} size={12.5} secondary />
        <lg::Badge label_by=>{"适用 SPT \{plan().target}"} tone={.Success} />
        <ui::Show when=>{plan().adapted} at_once>
          <lg::Badge label="已按当前布局调整" tone={.Accent} />
        </ui::Show>
      </ui::Row>
      let _ = lg::liquid_list_node(
        body,
        fn() {
          let out : Array[lg::LiquidListRow] = []
          for mp in plan().mappings {
            out.push(lg::LiquidListRow::new(title=mp.to, subtitle="来自 \{mp.from}", value="\{mp.files} 个文件"))
          }
          out
        },
        header=fn() { "将写入" },
        flat=true,
      )
      body.show(fn() { plan().conflicts.length() > 0 || plan().warnings.length() > 0 }, at_once=true, fn(w : view::View) -> Unit {
        <Label
          in={w}
          text_by=>{
            let p = plan()
            let lines : Array[String] = []
            if p.conflicts.length() > 0 {
              lines.push("\{p.conflicts.length()} 个文件已存在，安装时覆盖（原文件移到 .bunker/replaced）")
            }
            for x in p.warnings {
              lines.push(x)
            }
            model::str_join(lines, "\n")
          }
          size={12.5}
          color_by=>{lg::surface().warning}
          wrap
        />
      })
      <ui::Row in={body} rigid align={.Middle} gap={8.0}>
        <lg::Button flat height={btn_h} pad_x={14.0} label="上一步" on_press=>{s.drop_plan()} />
        <ui::Spacer />
        <lg::Button
          flat
          prominent
          height={btn_h}
          pad_x={14.0}
          label_by=>{if s.busy.get() == "installing" { "安装中…" } else { "确认安装" }}
          disabled_by=>{s.busy.get() == "installing"}
          on_press=>{
            match s.plan.untracked() {
              Some(pl) => s.install(pl.conflicts.length() > 0)
              None => ()
            }
          }
        />
      </ui::Row>
    }
  })
}
