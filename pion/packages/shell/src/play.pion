// The Play page: instance hero with the launch button (the one glass control in the page body), character,
// compatibility, launch options, instance status, and the server console (a solid disclosure, monospaced log).

import "headless"
import "icons"
import "lg"
import "model"
import "signals"
import "text"
import "ui"
import "view"

fn spt_of(s : model::Store) -> String {
  match s.current_inst() {
    Some(i) => if i.spt_version != "" { i.spt_version } else { "?" }
    None => "?"
  }
}

fn bad_words(m : model::ModItem, spt : String) -> String {
  let parts : Array[String] = []
  for b in m.bad_dlls {
    parts.push("\{b.shown}（为 SPT \{b.built_for} 编译，当前 \{spt}）")
  }
  model::str_join(parts, "、")
}

fn server_tone(st : String) -> lg::LiquidTone {
  if st == "ready" {
    .Success
  } else if st == "starting" {
    .Warning
  } else if st == "crashed" {
    .Danger
  } else {
    .Neutral
  }
}

fn server_label(srv : model::ServerStatus) -> String {
  if srv.state == "ready" {
    "服务端就绪 :\{srv.port}"
  } else if srv.state == "starting" {
    "服务端启动中…"
  } else if srv.state == "crashed" {
    "服务端异常退出"
  } else {
    "服务端未启动"
  }
}

fn ids_of(list : Array[model::ModItem]) -> Array[String] {
  let ids : Array[String] = []
  for m in list {
    ids.push(m.id)
  }
  ids
}

/// Disable the incompatible mods, or (when other mods depend on them) go to the step that asks about dependents.
fn safe_disable(s : model::Store, ask : () -> Unit) -> Unit {
  let list = s.incompatible_now()
  if model::dependents_of(list).length() == 0 {
    s.disable_mods(ids_of(list), false)
  } else {
    ask()
  }
}

pub fn play_page(pg : view::View, root : view::View, s : model::Store, back : () -> Unit) -> Unit {
  <lg::PageShell
    in={pg}
    top_edge_blur={true}
    leading={fn(l : view::View) -> Unit { <PageTitle in={l} title="启动" on_back={back} /> }}
    trailing={fn(tr : view::View) -> Unit { <WindowPills in={tr} /> }}
  >
    <ui::Col pad_x={24.0} gap={20.0}>
      <Hero root={root} s={s} />
      <ui::Show when=>{s.incompatible().length() > 0} at_once>
        <CompatAlert s={s} />
      </ui::Show>
      <SettingsSection root={root} s={s} />
      <Console s={s} />
      <ui::Spacer height={24.0} />
    </ui::Col>
  </lg::PageShell>
}

fn Hero(parent : view::View, root~ : view::View, s~ : model::Store) -> view::View {
  <ui::Row in={parent} align={.Middle} gap={12.0} pad_y={4.0}>
    <ui::Col width={0.0} grow={1.0} min_width={0.0} gap={6.0}>
      <ui::Row align={.Middle} gap={10.0} wrap line_gap={6.0}>
        <Label
          text_by=>{
            match s.current_inst() {
              Some(i) => if i.name != "" { i.name } else { i.root }
              None => "未选择 SPT 实例"
            }
          }
          size={24.0}
          weight={700}
        />
        <ui::Box
          ref_view={fn(v : view::View) {
            v.pick(fn() { s.server.get().state }, at_once=true, fn(slot : view::View, st : String) -> Unit {
              <lg::Badge in={slot} label_by=>{server_label(s.server.get())} tone={server_tone(st)} dot />
            })
          }}
        />
        <ui::Box
          ref_view={fn(v : view::View) {
            v.pick(fn() { compat_state(s) }, at_once=true, fn(slot : view::View, st : Int) -> Unit {
              if st == 2 {
                <lg::Badge in={slot} label_by=>{"\{s.incompatible().length()} 个 Mod 不兼容"} tone={.Danger} dot />
              } else if st == 1 {
                <lg::Badge in={slot} label="Mod 需处理" tone={.Warning} dot />
              } else {
                <lg::Badge in={slot} label="Mod 全部兼容" tone={.Success} dot />
              }
            })
          }}
        />
      </ui::Row>
      <Label
        text_by=>{
          match s.current_inst() {
            Some(i) => "EFT \{i.eft_version} · \{i.root}"
            None => "在左侧实例菜单里导入你的 SPT 目录"
          }
        }
        size={13.0}
        secondary
        wrap
      />
    </ui::Col>
    <ui::Box
      ref_view={fn(v : view::View) {
        v.pick(
          fn() { s.server.get().state == "ready" || s.server.get().state == "starting" },
          at_once=true,
          fn(slot : view::View, running : Bool) -> Unit {
            let _ = slot.row(view::Live::Is(true)).gap(view::Live::Is(8.0))
            if running {
              <lg::Button in={slot} flat height={btn_h} pad_x={12.0} label="重启服务端" on_press=>{s.restart_server()} />
              <lg::Button in={slot} flat height={btn_h} pad_x={12.0} label="停止" on_press=>{s.stop_server()} />
            } else {
              <lg::Button in={slot} flat height={btn_h} pad_x={12.0} label="仅启服务端" on_press=>{s.start_server()} />
            }
          },
        )
      }}
    />
    <LaunchButton root={root} s={s} />
  </ui::Row>
}

/// The launch button (prominent glass) and its compatibility gate popover (step 1 ↔ step 2 in place).
fn LaunchButton(parent : view::View, root~ : view::View, s~ : model::Store) -> view::View {
  lg::liquid_popover_node(
    parent,
    root,
    fn() { s.gate_open.get() },
    fn(v : Bool) -> Unit {
      s.gate_open.set(v)
      if !v {
        s.gate_step.set(1)
      }
    },
    fn() { "一键启动游戏" },
    fn(trig : view::View, _d : headless::Disclosure) -> Unit {
      <lg::Button
        in={trig}
        prominent
        height={36.0}
        pad_x={18.0}
        label_by=>{
          let g = s.game.get()
          if g == "launching" {
            "正在启动…"
          } else if g == "running" {
            "游戏运行中"
          } else {
            "一键启动游戏"
          }
        }
        on_press=>{s.try_launch()}
        disabled_by=>{s.game.get() == "launching" || s.current.get() == ""}
      />
    },
    fn() { "启动前兼容检查" },
    fn(pop : view::View) -> Unit { gate_popover_body(pop, s) },
    placement=.BelowEnd,
    width=420.0,
    radius=pop_r,
    pad=pop_pad,
  )
}

fn RolePicker(parent : view::View, root~ : view::View, s~ : model::Store) -> view::View {
  lg::liquid_popover_node(
    parent,
    root,
    fn() { s.role_open.get() },
    fn(v : Bool) -> Unit { s.role_open.set(v) },
    fn() { "切换角色" },
    fn(trig : view::View, _d : headless::Disclosure) -> Unit {
      <lg::Button in={trig} flat height={36.0} pad_x={14.0} label="切换" on_press=>{s.role_open.set(!s.role_open.untracked())} />
    },
    fn() { "选择出战角色" },
    fn(pop : view::View) -> Unit { role_popover_body(pop, s) },
    placement=.BelowEnd,
    width=340.0,
    radius=pop_r,
    pad=pop_pad,
  )
}

fn compat_state(s : model::Store) -> Int {
  if s.incompatible().length() > 0 {
    return 2
  }
  for m in s.mods.get() {
    if m.compat == "mismatch" {
      return 1
    }
  }
  0
}

/// Only when some enabled client mod is built for another SPT: a compact tinted strip with its fix (step 1 ↔ 2 in place).
fn CompatAlert(parent : view::View, s~ : model::Store) -> view::View {
  let step = signals::signal(1)
  parent.box(fn(strip : view::View) -> Unit {
    let _ = strip
      .radius(view::Live::Is(14.0))
      .ground(view::Live::By(fn() { lg::surface().danger_bg }))
      .padding(view::Live::Is((16.0, 14.0, 16.0, 14.0)))
      .gap(view::Live::Is(6.0))
    <ui::Row in={strip} align={.Middle} gap={10.0}>
      <icons::Icon name="alert-triangle" size={18.0} color_by=>{lg::surface().danger} />
      <Label
        text_by=>{"\{s.incompatible().length()} 个客户端 Mod 与 SPT \{spt_of(s)} 不兼容"}
        size={14.0}
        weight={600}
        grow
      />
      <ui::Box
        ref_view={fn(v : view::View) {
          v.pick(fn() { step.get() }, at_once=true, fn(act : view::View, st : Int) -> Unit {
            let _ = act.row(view::Live::Is(true)).gap(view::Live::Is(8.0)).lines_up(view::Live::Is(Some(view::Along::Middle)))
            if st == 1 {
              <lg::Button in={act} flat height={btn_h} pad_x={12.0} label="安全禁用" on_press=>{safe_disable(s, fn() { step.set(2) })} />
              act.show(
                fn() {
                  for m in s.incompatible() {
                    if m.fix_url != "" {
                      return true
                    }
                  }
                  false
                },
                at_once=true,
                fn(y : view::View) -> Unit {
                  <lg::Button
                    in={y}
                    flat
                    prominent
                    height={btn_h}
                    pad_x={12.0}
                    label="一键更新"
                    on_press=>{
                      let ids : Array[String] = []
                      for m in s.incompatible_now() {
                        if m.fix_url != "" {
                          ids.push(m.id)
                        }
                      }
                      s.fix_mods(ids)
                    }
                  />
                },
              )
            } else {
              <lg::Button in={act} flat height={btn_h} pad_x={12.0} label="取消" on_press=>{step.set(1)} />
              <lg::Button
                in={act}
                flat
                height={btn_h}
                pad_x={12.0}
                label="仅禁用"
                on_press=>{
                  step.set(1)
                  s.disable_mods(ids_of(s.incompatible_now()), false)
                }
              />
              <lg::Button
                in={act}
                flat
                tint={lg::surface().danger}
                height={btn_h}
                pad_x={12.0}
                label="连同依赖"
                on_press=>{
                  step.set(1)
                  s.disable_mods(ids_of(s.incompatible_now()), true)
                }
              />
            }
          })
        }}
      />
    </ui::Row>
    <Label
      in={strip}
      pad_left={28.0}
      text_by=>{
        let v = spt_of(s)
        let lines : Array[String] = []
        for m in s.incompatible() {
          let dep = if m.required_by.length() > 0 { "（\{m.needed_by()} 依赖它）" } else { "" }
          lines.push("\{m.name}：\{bad_words(m, v)}\{dep}")
        }
        model::str_join(lines, "\n")
      }
      size={12.5}
      secondary
      wrap
    />
  })
}

fn ToggleRow(parent : view::View, title~ : String, caption~ : String, on_by~ : () -> Bool, on_change~ : (Bool) -> Unit) -> view::View {
  <SectionRow in={parent}>
    <ui::Col width={0.0} grow={1.0} min_width={0.0} gap={2.0}>
      <Label text={title} size={14.0} weight={500} />
      <Label text={caption} size={12.0} secondary wrap />
    </ui::Col>
    <ui::Box shrink={0.0}>
      <lg::Toggle label={title} on_by={on_by} on_change={on_change} />
    </ui::Box>
  </SectionRow>
}

/// One grouped list for everything set before a launch: who plays, and the two launch options.
fn SettingsSection(parent : view::View, root~ : view::View, s~ : model::Store) -> view::View {
  <lg::SurfaceSection in={parent} header="启动设置">
    <SectionRow>
      <ui::Col width={0.0} grow={1.0} min_width={0.0} gap={2.0}>
        <Label
          text_by=>{
            match s.current_character() {
              Some(c) => "出战角色：\{c.shown()} · \{c.side} Lv.\{c.level}"
              None => "出战角色：未检测到角色存档"
            }
          }
          size={14.0}
          weight={500}
          lines={1}
        />
        <Label
          text_by=>{
            match s.current_character() {
              Some(c) => "\{c.edition} · \{model::roubles_text(c.roubles)}"
              None => "首次启动服务端后会自动创建角色"
            }
          }
          size={12.0}
          secondary
        />
      </ui::Col>
      <RolePicker root={root} s={s} />
    </SectionRow>
    <Divider />
    <ToggleRow
      title="启动前清理缓存"
      caption="避免旧着色器与本地缓存冲突"
      on_by=>{s.clean_cache.get()}
      on_change={fn(on : Bool) -> Unit { s.set_setting("clean_cache", on) }}
    />
    <Divider />
    <ToggleRow
      title="启动后最小化"
      caption="减少后台资源占用"
      on_by=>{s.minimize.get()}
      on_change={fn(on : Bool) -> Unit { s.set_setting("minimize", on) }}
    />
  </lg::SurfaceSection>
}

fn log_ink(level : String) -> Int64 {
  if level == "error" {
    lg::surface().danger
  } else if level == "warn" {
    lg::surface().warning
  } else {
    lg::surface().ink
  }
}

/// The server console: a solid disclosure, collapsed to one row until opened, over a monospaced log.
fn Console(parent : view::View, s~ : model::Store) -> view::View {
  <lg::Disclosure
    in={parent}
    title="服务端控制台"
    subtitle_by=>{
      let w = s.server.get().warns
      let n = s.log.get().length()
      if w > 0 { "\{n} 行日志 · \{w} 条警告" } else { "\{n} 行日志" }
    }
    open_by=>{s.console_open.get()}
    on_toggle={fn(v : Bool) -> Unit { s.console_open.set(v) }}
  >
    <ui::Col gap={8.0}>
      <ui::Row align={.Middle} gap={8.0}>
        <Label text_by=>{s.server.get().message} size={12.5} secondary lines={1} grow />
        <lg::Button flat height={28.0} pad_x={10.0} label="清空" on_press=>{s.log.set([])} disabled_by=>{s.log.get().length() == 0} />
      </ui::Row>
      <ui::Box
        ref_view={fn(box : view::View) {
          let _ = box
            .height(view::Live::Is(Some(200.0)))
            .radius(view::Live::Is(lg::concentric(22.0, 18.0)))
            .ground(view::Live::By(fn() { lg::surface().code_bg }))
            .edge(view::Live::By(fn() { (lg::hairline_w, lg::surface().separator) }))
            .clips(view::Live::Is(true))
          let _ = ui::scroll_box(box, fn(sc : view::View) -> Unit {
            let _ = sc.padding(view::Live::Is((12.0, 10.0, 12.0, 10.0))).gap(view::Live::Is(4.0))
            sc.show(fn() { s.log.get().length() == 0 }, at_once=true, fn(empty : view::View) -> Unit {
              <Label in={empty} text="等待服务端输出…" size={12.5} secondary />
            })
            sc.each(
              fn() { s.log.get() },
              fn(l : model::LogLine) -> Int { l.n },
              fn(slot : view::View, line : signals::Signal[model::LogLine]) -> Unit {
                let _ = slot.box(fn(w : view::View) -> Unit {
                  let _ = w
                    .words_runs(
                      view::Live::By(fn() {
                        let l = line.get()
                        [
                          text::Run::{ ..text::plain("\{l.t}  "), mono: true, color: lg::surface().ink_secondary },
                          text::Run::{ ..text::plain(l.text), mono: true, color: log_ink(l.level) },
                        ]
                      }),
                      look=lg::words_at(12.0, wrap=true),
                    )
                    .ink(view::Live::By(ink))
                })
              },
            )
          })
        }}
      />
    </ui::Col>
  </lg::Disclosure>
}

pub fn role_popover_body(pop : view::View, s : model::Store) -> Unit {
  let _ = pop.gap(view::Live::Is(10.0))
  <ui::Row in={pop} rigid align={.Middle} gap={8.0} pad_x={4.0}>
    <Label text="选择出战角色" size={15.0} weight={700} grow />
    <lg::Badge label_by=>{"\{s.characters.get().length()} 个存档"} tone={.Neutral} />
  </ui::Row>
  let _ = lg::liquid_list_node(
    pop,
    fn() {
      let cur = s.character.get()
      let out : Array[lg::LiquidListRow] = []
      for c in s.characters.get() {
        let name = c.username
        out.push(lg::LiquidListRow::new(
          title=c.shown(),
          subtitle="\{c.edition} · \{model::roubles_text(c.roubles)}",
          value="\{c.side} Lv.\{c.level}",
          active=c.username == cur,
          on_press=fn() {
            s.character.set(name)
            s.role_open.set(false)
          },
        ))
      }
      out
    },
    flat=true,
  )
  <ui::Row in={pop} rigid align={.Middle} gap={8.0}>
    <Label text="启动游戏时以所选角色登录" size={12.0} secondary grow />
    <lg::Button flat height={btn_h} pad_x={14.0} label="完成" on_press=>{s.role_open.set(false)} />
  </ui::Row>
}

pub fn gate_popover_body(pop : view::View, s : model::Store) -> Unit {
  let _ = pop.gap(view::Live::Is(10.0))
  pop.pick(fn() { s.gate_step.get() }, at_once=true, fn(body : view::View, step : Int) -> Unit {
    let _ = body.gap(view::Live::Is(10.0))
    if step == 1 {
      <ui::Row in={body} rigid align={.Middle} gap={8.0} pad_x={4.0}>
        <Label text="启动前发现不兼容的 Mod" size={15.0} weight={700} grow />
        <lg::Badge label_by=>{"SPT \{spt_of(s)}"} tone={.Danger} />
      </ui::Row>
      let _ = lg::liquid_list_node(
        body,
        fn() {
          let v = spt_of(s)
          let out : Array[lg::LiquidListRow] = []
          for m in s.incompatible() {
            out.push(lg::LiquidListRow::new(title=m.name, subtitle=bad_words(m, v), value=if m.fix_url != "" { "可更新" } else { "" }))
          }
          out
        },
        flat=true,
      )
      <Label in={body} text="继续启动可能在加载时报错或闪退。" size={12.5} secondary wrap />
      <ui::Row in={body} rigid align={.Middle} gap={8.0}>
        <lg::Button flat height={btn_h} pad_x={12.0} label="仍然启动" on_press=>{s.launch_past_gate()} />
        <ui::Spacer />
        <lg::Button flat height={btn_h} pad_x={12.0} label="安全禁用" on_press=>{safe_disable(s, fn() { s.gate_step.set(2) })} />
        <lg::Button
          flat
          prominent
          height={btn_h}
          pad_x={12.0}
          label="一键更新"
          disabled_by=>{
            for m in s.incompatible() {
              if m.fix_url != "" {
                return false
              }
            }
            true
          }
          on_press=>{
            let ids : Array[String] = []
            for m in s.incompatible_now() {
              if m.fix_url != "" {
                ids.push(m.id)
              }
            }
            s.fix_mods(ids)
          }
        />
      </ui::Row>
    } else {
      <ui::Row in={body} rigid align={.Middle} gap={8.0} pad_x={4.0}>
        <Label text="还有 Mod 依赖它们" size={15.0} weight={700} grow />
        <lg::Badge label="步骤 2 / 2" tone={.Warning} />
      </ui::Row>
      let _ = lg::liquid_list_node(
        body,
        fn() {
          let out : Array[lg::LiquidListRow] = []
          for m in s.incompatible() {
            if m.required_by.length() > 0 {
              out.push(lg::LiquidListRow::new(title=m.name, subtitle="被 \{m.needed_by()} 依赖"))
            }
          }
          out
        },
        flat=true,
      )
      <Label in={body} text="只禁用不兼容的 Mod，依赖它的 Mod 加载时可能报错；连同依赖会一起移到 .bunker/disabled。" size={12.5} secondary wrap />
      <ui::Row in={body} rigid align={.Middle} gap={8.0}>
        <lg::Button flat height={btn_h} pad_x={12.0} label="返回" on_press=>{s.gate_step.set(1)} />
        <ui::Spacer />
        <lg::Button flat height={btn_h} pad_x={12.0} label="仅禁用" on_press=>{s.disable_mods(ids_of(s.incompatible_now()), false)} />
        <lg::Button
          flat
          tint={lg::surface().danger}
          height={btn_h}
          pad_x={12.0}
          label="连同依赖"
          on_press=>{s.disable_mods(ids_of(s.incompatible_now()), true)}
        />
      </ui::Row>
    }
  })
}
