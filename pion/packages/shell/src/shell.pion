// Bunker's window on invar `lg` (AFK-surf/invar main 368ff1b), Apple's two layers:
// - Content Layer: `<lg::SplitShell>` (solid `surface().sidebar` + 0.5pt hairline; sidebar or page below 760pt),
//   each page a `<lg::PageShell>` (one full-height `ui::scroll_box` gliding under the floating top bar), solid
//   `SurfaceCard` / `SurfaceSection` / `liquid_list_node(glass=false)` content, flat controls inside.
// - Glass only floats: the top bar's pills, search / filter bars, the launch button, popovers and the toast.
// Every popover is an `lg::liquid_popover_node` mounted on `root`; a popover's second step replaces its first in
// place (never a second popover over it).

import "headless"
import "icons"
import "lg"
import "model"
import "signals"
import "ui"
import "view"

fn page_title(p : model::Page) -> String {
  match p {
    .Play => "启动"
    .Mods => "Mod 管理"
    .Snapshots => "存档快照"
    .Config => "配置文件"
  }
}

/// The whole window. `root` also hosts the popovers and the toast so they paint above sidebar and page.
pub fn bunker_app(root : view::View, s : model::Store) -> Unit {
  ui::set_tree_theme(lg::ui_theme)
  // Narrow windows show the sidebar or a page; a page's back island goes back to the sidebar.
  let show_detail = signals::signal(true)
  let back = fn() { show_detail.set(false) }
  <lg::SplitShell
    in={root}
    sidebar_width={248.0}
    show_detail_by=>{show_detail.get()}
    sidebar={fn(sb : view::View) -> Unit { sidebar(sb, root, s, show_detail) }}
    detail={fn(dt : view::View) -> Unit {
      // `keeps`: a page left is parked, not torn down, so coming back to Mod (89 rows) or 配置文件 (113) is not a fresh
      // mount (measured on Windows: ~72 ms of layout and ~44 ms of encode each time it was made again).
      dt.pick(fn() { model::page_index(s.page.get()) }, at_once=true, keeps=true, fn(pg : view::View, idx : Int) -> Unit {
        let _ = pg.fill()
        if idx == 1 {
          mods_page(pg, root, s, back)
        } else if idx == 2 {
          snapshots_page(pg, s, back)
        } else if idx == 3 {
          config_page(pg, s, back)
        } else {
          play_page(pg, root, s, back)
        }
      })
    }}
  />
  let _ = root.box(fn(layer : view::View) -> Unit {
    let _ = layer
      .over(view::Live::Is(true))
      .points(view::Live::Is(false))
      .lines_up(view::Live::Is(Some(view::Along::Middle)))
      .lies_along(view::Live::Is(view::Lies::End))
      .padding(view::Live::Is((0.0, 0.0, 0.0, 22.0)))
    <lg::Toast
      in={layer}
      visible_by=>{s.toast.get().is_some()}
      title_by=>{
        match s.toast.get() {
          Some(t) => t.text
          None => ""
        }
      }
      status={.Info}
      on_dismiss=>{s.dismiss_toast()}
    />
  })
}

fn sidebar(sb : view::View, root : view::View, s : model::Store, show_detail : signals::Signal[Bool]) -> Unit {
  let go = fn(p : model::Page) -> Unit {
    s.page.set(p)
    show_detail.set(true)
  }
  <ui::Col in={sb} fill pad_x={14.0} pad_y={10.0} gap={14.0}>
    <ui::Row moves_window rigid height={44.0} align={.Middle} gap={8.0} pad_x={6.0}>
      <icons::Icon name="shield" size={20.0} color_by=>{accent()} />
      <Label text="Bunker" size={17.0} weight={700} grow />
      <Label text="SPT 启动器" size={12.0} secondary />
    </ui::Row>
    <InstancePicker root={root} s={s} />
    <NavList s={s} go={go} />
    <ui::Spacer />
    <ui::Row rigid align={.Middle} gap={8.0} pad_x={6.0}>
      <ui::Box
        width={8.0}
        height={8.0}
        radius={4.0}
        shrink={0.0}
        bg_by=>{
          let st = s.server.get().state
          if st == "ready" {
            lg::surface().positive
          } else if st == "starting" {
            lg::surface().warning
          } else if st == "crashed" {
            lg::surface().danger
          } else {
            ink2()
          }
        }
      />
      <Label
        text_by=>{
          let srv = s.server.get()
          if srv.state == "ready" {
            "服务端就绪 :\{srv.port}"
          } else if srv.state == "starting" {
            "服务端启动中…"
          } else if srv.state == "crashed" {
            "服务端异常退出"
          } else {
            "服务端未运行"
          }
        }
        size={12.5}
        secondary
        grow
      />
      <ui::Box
        ref_view={fn(v : view::View) {
          let _ = lg::liquid_button_node(
            v,
            fn() { if lg::is_dark() { "切换为浅色外观" } else { "切换为深色外观" } },
            fn() { lg::set_dark(Some(!lg::is_dark())) },
            flat=true,
            ghost=true,
            height=32.0,
            pad_x=10.0,
            content=fn(c : view::View) -> Unit {
              c.pick(fn() { lg::is_dark() }, at_once=true, fn(slot : view::View, dark : Bool) -> Unit {
                <icons::Icon in={slot} name={if dark { "sun" } else { "moon" }} size={16.0} color_by=>{ink()} />
              })
            },
          )
        }}
      />
    </ui::Row>
  </ui::Col>
}

fn NavList(parent : view::View, s~ : model::Store, go~ : (model::Page) -> Unit) -> view::View {
  let count = fn(n : Int) -> String { if n > 0 { "\{n}" } else { "" } }
  let at = fn(p : model::Page) -> Bool { model::page_index(s.page.get()) == model::page_index(p) }
  <ui::Col in={parent} gap={2.0}>
    <PlainRow title_by=>{"启动"} icon="play" icon_color=>{lg::surface().accent} active_by=>{at(.Play)} on_press=>{go(.Play)} />
    <PlainRow
      title_by=>{"Mod"}
      value_by=>{count(s.mods.get().length())}
      icon="layers"
      icon_color=>{0x5856D6FFL}
      active_by=>{at(.Mods)}
      on_press=>{go(.Mods)}
    />
    <PlainRow
      title_by=>{"存档快照"}
      value_by=>{count(s.snapshots.get().length())}
      icon="archive"
      icon_color=>{lg::surface().positive}
      active_by=>{at(.Snapshots)}
      on_press=>{go(.Snapshots)}
    />
    <PlainRow
      title_by=>{"配置文件"}
      value_by=>{count(s.configs.get().length())}
      icon="file-text"
      icon_color=>{lg::surface().warning}
      active_by=>{at(.Config)}
      on_press=>{go(.Config)}
    />
  </ui::Col>
}

fn inst_name(s : model::Store) -> String {
  match s.current_inst() {
    Some(i) => if i.name != "" { i.name } else { i.root }
    None => "导入 SPT 实例"
  }
}

/// The sidebar's instance picker: a flat button opening the instance popover (list ↔ import, one popover).
fn InstancePicker(parent : view::View, root~ : view::View, s~ : model::Store) -> view::View {
  lg::liquid_popover_node(
    parent,
    root,
    fn() { s.inst_open.get() },
    fn(v : Bool) -> Unit {
      s.inst_open.set(v)
      if !v {
        s.inst_step.set(1)
      }
    },
    fn() { "切换 SPT 实例" },
    fn(trig : view::View, _d : headless::Disclosure) -> Unit {
      let _ = lg::liquid_button_node(
        trig,
        fn() { inst_name(s) },
        fn() { s.inst_open.set(!s.inst_open.untracked()) },
        flat=true,
        height=40.0,
        pad_x=12.0,
        content=fn(c : view::View) -> Unit {
          let _ = c.grow(view::Live::Is(1.0)).row(view::Live::Is(true)).gap(view::Live::Is(8.0)).lines_up(view::Live::Is(Some(view::Along::Middle)))
          <icons::Icon in={c} name="server" size={16.0} color_by=>{ink2()} />
          <Label in={c} text_by=>{inst_name(s)} size={13.5} weight={600} lines={1} grow />
          <icons::Icon in={c} name="chevrons-up-down" size={14.0} color_by=>{ink2()} />
        },
      ).grow(view::Live::Is(1.0))
    },
    fn() { "SPT 实例" },
    fn(pop : view::View) -> Unit { instance_popover_body(pop, s) },
    placement=.BelowStart,
    width=380.0,
    radius=pop_r,
    pad=pop_pad,
  )
}

fn inst_row(i : model::Inst, current : String, on_press : () -> Unit) -> lg::LiquidListRow {
  lg::LiquidListRow::new(
    title=if i.name != "" { i.name } else { model::str_basename(i.root) },
    subtitle=i.root,
    value="SPT \{i.spt_version}",
    active=i.root == current,
    on_press=on_press,
  )
}

pub fn instance_popover_body(pop : view::View, s : model::Store) -> Unit {
  let path_field = ui::Field::new()
  let _ = pop.gap(view::Live::Is(10.0))
  pop.pick(fn() { s.inst_step.get() }, at_once=true, fn(body : view::View, step : Int) -> Unit {
    let _ = body.gap(view::Live::Is(14.0))
    if step == 1 {
      <ui::Row in={body} rigid align={.Middle} gap={8.0} pad_x={4.0}>
        <Label text="SPT 实例" size={15.0} weight={700} grow />
        <lg::Badge label_by=>{"\{s.instances.get().length()} 个"} tone={.Neutral} />
      </ui::Row>
      let _ = lg::liquid_list_node(
        body,
        fn() {
          let cur = s.current.get()
          let out : Array[lg::LiquidListRow] = []
          for i in s.instances.get() {
            let root = i.root
            out.push(inst_row(i, cur, fn() {
              s.select_instance(root)
              s.inst_open.set(false)
            }))
          }
          out
        },
        flat=true,
      )
      <ui::Row in={body} rigid align={.Middle} gap={8.0}>
        <Label text="切换后重新读取 Mod、存档与配置" size={12.0} secondary grow />
        <lg::Button flat prominent height={btn_h} pad_x={14.0} label="导入新实例" on_press=>{s.open_import()} />
      </ui::Row>
    } else {
      <ui::Row in={body} rigid align={.Middle} gap={8.0} pad_x={4.0}>
        <Label text="导入 SPT 实例" size={15.0} weight={700} grow />
        <lg::Badge label="步骤 2 / 2" tone={.Accent} />
      </ui::Row>
      let _ = lg::liquid_text_field_node(
        body,
        path_field,
        placeholder="SPT 根目录，如 C:\\Games\\SPT-4.1.6",
        label=fn() { "实例目录" },
        flat=true,
        show_label=false,
        edited=fn(p : String) -> Unit { s.probe_path_now(p) },
        submitted=fn(p : String) -> Unit { s.add_instance(p) },
      )
      body.show(fn() { s.probe.get().is_some() }, at_once=true, fn(pr : view::View) -> Unit {
        <ui::Row in={pr} align={.Middle} gap={8.0} pad_x={4.0}>
          <lg::Badge
            label_by=>{
              match s.probe.get() {
                Some(i) => if i.valid { "可导入" } else { "不完整" }
                None => ""
              }
            }
            tone={.Success}
            dot
          />
          <Label
            text_by=>{
              match s.probe.get() {
                Some(i) => "SPT \{i.spt_version} · EFT \{i.eft_version}"
                None => ""
              }
            }
            size={12.5}
            secondary
            grow
          />
        </ui::Row>
      })
      body.show(fn() { s.found.get().length() > 0 }, at_once=true, fn(fd : view::View) -> Unit {
        let _ = lg::liquid_list_node(
          fd,
          fn() {
            let out : Array[lg::LiquidListRow] = []
            for i in s.found.get() {
              let root = i.root
              out.push(inst_row(i, "", fn() { s.add_instance(root) }))
            }
            out
          },
          header=fn() { "在本机找到的 SPT" },
          flat=true,
        )
      })
      <ui::Row in={body} rigid align={.Middle} gap={8.0}>
        <lg::Button flat height={btn_h} pad_x={14.0} label="返回" on_press=>{s.inst_step.set(1)} />
        <ui::Spacer />
        <lg::Button
          flat
          prominent
          height={btn_h}
          pad_x={14.0}
          label="导入"
          on_press=>{s.add_instance(path_field.text())}
        />
      </ui::Row>
    }
  })
}
