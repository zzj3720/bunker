// macOS 27 Golden Gate Bunker shell:
// - Edge-to-edge full-height sidebar (224px) with crisp 1px structural separation & colorful official 24-grid icons
// - Cohesive transparent draggable top toolbar (.moves_window) with page title + window button group
// - Pure neutral content canvas (#FFFFFF light / #141416 dark)

import "headless"
import "hostapi"
import "lg"
import "model"
import "signals"
import "ui"
import "view"

fn page_title(p : model::Page) -> String {
  match p {
    model::Page::Play => "启动"
    model::Page::Mods => "Mod 管理"
    model::Page::Snapshots => "存档快照"
    model::Page::Config => "配置文件"
  }
}

pub fn bunker_app(root : view::View, s : model::Store) -> Unit {
  ui::set_tree_theme(lg::ui_theme)
  let _ = root.box(fn(stage : view::View) -> Unit {
    let _ = stage
      .grow(view::Live::Is(1.0))
      .row(view::Live::Is(true))
      .clips(view::Live::Is(true))
      .ground(view::Live::By(canvas_bg))

    // ======== 1. Edge-to-Edge macOS 27 Golden Gate Sidebar (224px) ========
    let _ = stage.box(fn(side : view::View) -> Unit {
      let _ = side
        .width(view::Live::Is(Some(224.0)))
        .shrink(view::Live::Is(0.0))
        .ground(view::Live::By(sidebar_bg))
        .padding(view::Live::Is((14.0, 14.0, 14.0, 16.0)))
        .gap(view::Live::Is(16.0))

      // Sidebar top: draggable brand header
      let _ = side.box(fn(brand : view::View) -> Unit {
        let _ = brand
          .moves_window(view::Live::Is(true))
          .row(view::Live::Is(true))
          .height(view::Live::Is(Some(32.0)))
          .padding(view::Live::Is((6.0, 0.0, 6.0, 0.0)))
          .lines_up(view::Live::Is(Some(view::Along::Middle)))
          .gap(view::Live::Is(8.0))
        let _ = label(brand, "Bunker", size=15.5, weight=700)
        spacer(brand)
        let _ = label(brand, "SPT", size=11.0, weight=600, ink=ink_muted)
      })

      // Instance switcher (official lg::liquid_popover_node + lg::liquid_button_node)
      let _ = lg::liquid_popover_node(
        side,
        stage,
        fn() { s.inst_open.get() },
        fn(v : Bool) -> Unit {
          s.inst_open.set(v)
          if !v { s.inst_step.set(1) }
        },
        fn() { "切换 SPT 实例" },
        fn(trig : view::View, _d : headless::Disclosure) -> Unit {
          let _ = lg::liquid_button_node(
            trig,
            fn() {
              match s.current_inst() {
                Some(i) => if i.name != "" { i.name } else { "Bunker" }
                None => "导入 SPT 实例"
              }
            },
            fn() { s.inst_open.set(!s.inst_open.untracked()) },
            content=fn(c : view::View) -> Unit {
              let _ = c
                .grow(view::Live::Is(1.0))
                .row(view::Live::Is(true))
                .gap(view::Live::Is(6.0))
                .lines_up(view::Live::Is(Some(view::Along::Middle)))
              let _ = label_by(
                c,
                fn() {
                  match s.current_inst() {
                    Some(i) => if i.name != "" { i.name } else { "Bunker" }
                    None => "导入 SPT 实例"
                  }
                },
                size=13.5,
                weight=600,
              ).grow(view::Live::Is(1.0))
              icon_node(c, icon_chevron_down_data, 14.0, ink_secondary)
            },
          ).grow(view::Live::Is(1.0))
        },
        fn() { "实例切换与导入" },
        fn(pop : view::View) -> Unit { instance_popover_body(pop, s) },
        placement=headless::Placement::BelowStart,
        width=360.0,
      )

      // Primary Navigation List (Golden Gate colorful semantic icons)
      let _ = side.box(fn(nav : view::View) -> Unit {
        let _ = nav.gap(view::Live::Is(4.0))
        sidebar_nav_item(nav, s, model::Page::Play, "启动", icon_play_data, c_cobalt, fn() { "" })
        sidebar_nav_item(nav, s, model::Page::Mods, "Mod", icon_sliders_data, c_indigo, fn() {
          let n = s.mods.get().length()
          if n > 0 { "\{n}" } else { "" }
        })
        sidebar_nav_item(nav, s, model::Page::Snapshots, "存档", icon_archive_data, c_green, fn() {
          let n = s.snapshots.get().length()
          if n > 0 { "\{n}" } else { "" }
        })
        sidebar_nav_item(nav, s, model::Page::Config, "配置", icon_file_text_data, c_orange, fn() {
          let n = s.configs.get().length()
          if n > 0 { "\{n}" } else { "" }
        })
      })

      spacer(side)

      // Sidebar Footer: Server status indicator + Light/Dark toggle
      let _ = hrow(side, 8.0, fn(foot : view::View) -> Unit {
        let _ = foot.padding(view::Live::Is((6.0, 0.0, 2.0, 0.0)))
        let _ = foot.box(fn(dot : view::View) -> Unit {
          let _ = dot
            .width(view::Live::Is(Some(8.0)))
            .height(view::Live::Is(Some(8.0)))
            .shrink(view::Live::Is(0.0))
            .radius(view::Live::Is(4.0))
            .ground(view::Live::By(fn() {
              let st = s.server.get().state
              if st == "ready" { c_green } else if st == "starting" { c_amber } else if st == "crashed" { c_red } else { ink_muted() }
            }))
        })
        let _ = label_by(
          foot,
          fn() {
            let srv = s.server.get()
            if srv.state == "ready" {
              "就绪 :\{srv.port}"
            } else if srv.state == "starting" {
              "启动中…"
            } else if srv.state == "crashed" {
              "异常退出"
            } else {
              "未运行"
            }
          },
          size=12.5,
          weight=500,
          ink=ink_secondary,
        ).grow(view::Live::Is(1.0))

        let _ = lg::liquid_icon_button_node(
          foot,
          fn() { "切换深浅外观" },
          fn(ic : view::View, ink : () -> Int64) -> Unit {
            icon_node(ic, if lg::is_dark() { icon_sun_data } else { icon_moon_data }, 16.0, ink)
          },
          fn() { lg::set_dark(Some(!lg::is_dark())) },
          size=lg::LiquidButtonSize::Small,
        )
      })
    })

    // Crisp 1px Golden Gate structural edge between sidebar and content
    let _ = stage.box(fn(edge : view::View) -> Unit {
      let _ = edge.width(view::Live::Is(Some(1.0))).shrink(view::Live::Is(0.0)).ground(view::Live::By(sidebar_edge))
    })

    // ======== 2. Right Content Canvas (Cohesive Top Toolbar + Page Content) ========
    let _ = stage.box(fn(main_col : view::View) -> Unit {
      let _ = main_col
        .grow(view::Live::Is(1.0))
        .basis(view::Live::Is(Some(0.0)))
        .min_width(view::Live::Is(Some(0.0)))
        .min_height(view::Live::Is(Some(0.0)))

      // Cohesive 52px draggable top bar (page title left, compact window controls right)
      let _ = main_col.box(fn(bar : view::View) -> Unit {
        let _ = bar
          .moves_window(view::Live::Is(true))
          .row(view::Live::Is(true))
          .height(view::Live::Is(Some(54.0)))
          .padding(view::Live::Is((28.0, 10.0, 20.0, 6.0)))
          .lies_along(view::Live::Is(view::Lies::Between))
          .lines_up(view::Live::Is(Some(view::Along::Middle)))

        let _ = label_by(bar, fn() { page_title(s.page.get()) }, size=16.5, weight=700)

        let _ = lg::liquid_button_group_node(
          bar,
          fn() {
            [
              lg::LiquidGroupAction::new(
                label=fn() { "最小化" },
                icon=fn(ic : view::View, ink : () -> Int64) -> Unit { icon_node(ic, icon_minus_data, 15.0, ink) },
                press=fn() { hostapi::window_act(1) },
              ),
              lg::LiquidGroupAction::new(
                label=fn() { "关闭" },
                icon=fn(ic : view::View, ink : () -> Int64) -> Unit { icon_node(ic, icon_close_data, 15.0, ink) },
                press=fn() { hostapi::window_act(3) },
              ),
            ]
          },
          size=lg::LiquidButtonSize::Small,
        )
      })

      // Active Page Body
      let _ = main_col.box(fn(body_pad : view::View) -> Unit {
        let _ = body_pad
          .grow(view::Live::Is(1.0))
          .min_height(view::Live::Is(Some(0.0)))
          .padding(view::Live::Is((28.0, 8.0, 28.0, 24.0)))
        let _ = body_pad.pick(fn() { model::page_index(s.page.get()) }, fn(body : view::View, idx : Int) -> Unit {
          let _ = body.grow(view::Live::Is(1.0)).min_height(view::Live::Is(Some(0.0)))
          if idx == 1 {
            mods_page(body, stage, s)
          } else if idx == 2 {
            snapshots_page(body, s)
          } else if idx == 3 {
            config_page(body, s)
          } else {
            play_page(body, stage, s)
          }
        })
      })
    })

    // Floating Liquid Toast
    let _ = stage.box(fn(toast_layer : view::View) -> Unit {
      let _ = toast_layer
        .over(view::Live::Is(true))
        .points(view::Live::Is(false))
        .lines_up(view::Live::Is(Some(view::Along::Middle)))
        .lies_along(view::Live::Is(view::Lies::End))
        .padding(view::Live::Is((0.0, 0.0, 0.0, 22.0)))
      let _ = lg::liquid_toast_node(
        toast_layer,
        fn() { match s.toast.get() { Some(_) => true; None => false } },
        fn() { match s.toast.get() { Some(t) => t.text; None => "" } },
        status=lg::LiquidStatus::Info,
        on_dismiss=fn() { s.dismiss_toast() },
      )
    })
  })
}

fn sidebar_nav_item(
  parent : view::View,
  s : model::Store,
  page : model::Page,
  title : String,
  icon_data : String,
  icon_color : Int64,
  count : () -> String,
) -> Unit {
  let _ = headless::button(
    parent,
    fn() { title },
    fn(_e) -> Unit { s.page.set(page) },
    fn(r : view::View, btn : headless::Button) -> Unit {
      let active = fn() -> Bool { model::page_index(s.page.get()) == model::page_index(page) }
      let _ = r
        .row(view::Live::Is(true))
        .height(view::Live::Is(Some(36.0)))
        .padding(view::Live::Is((10.0, 0.0, 10.0, 0.0)))
        .gap(view::Live::Is(10.0))
        .radius(view::Live::Is(10.0))
        .lines_up(view::Live::Is(Some(view::Along::Middle)))
        .ground(view::Live::By(fn() {
          if active() {
            row_selected_bg()
          } else if btn.hovered() {
            row_hover_bg()
          } else {
            lg::clear
          }
        }))
      icon_node(r, icon_data, 17.0, fn() { if active() { c_cobalt } else { icon_color } })
      let _ = label_by(
        r,
        fn() { title },
        size=14.0,
        weight=600,
        ink=fn() { if active() { c_cobalt } else { ink_primary() } },
      ).grow(view::Live::Is(1.0))
      r.show(fn() { count() != "" }, fn(cnt : view::View) -> Unit {
        let _ = label_by(cnt, count, size=12.0, weight=500, ink=ink_muted)
      })
    },
  )
}

fn instance_popover_body(pop : view::View, s : model::Store) -> Unit {
  let path_field = ui::Field::new()
  let _ = pop.gap(view::Live::Is(10.0))
  let _ = hrow(pop, 8.0, fn(h : view::View) -> Unit {
    let _ = label_by(h, fn() { if s.inst_step.get() == 1 { "已管理 SPT 实例" } else { "导入新 SPT 实例" } }, size=14.5, weight=700).grow(view::Live::Is(1.0))
    let _ = h.pick(fn() { s.inst_step.get() }, fn(slot : view::View, st : Int) -> Unit {
      if st == 1 {
        let _ = glass_action(slot, fn() { "导入新实例" }, fn() { s.open_import() }, tint=c_cobalt, flat=true)
      } else {
        let _ = glass_action(slot, fn() { "返回列表" }, fn() { s.inst_step.set(1) }, flat=true)
      }
    })
  })
  let _ = pop.pick(fn() { s.inst_step.get() }, fn(body : view::View, st : Int) -> Unit {
    let _ = body.gap(view::Live::Is(6.0))
    if st == 1 {
      body.each(
        fn() { s.instances.get() },
        fn(i : model::Inst) -> String { i.root },
        fn(slot : view::View, inst_sig : signals::Signal[model::Inst]) -> Unit {
          let _ = headless::button(
            slot,
            fn() { inst_sig.get().name },
            fn(_e) -> Unit { s.select_instance(inst_sig.untracked().root) },
            fn(r : view::View, btn : headless::Button) -> Unit {
              let active = fn() -> Bool { s.current.get() == inst_sig.get().root }
              let _ = r
                .padding(view::Live::Is((10.0, 9.0, 10.0, 9.0)))
                .radius(view::Live::Is(10.0))
                .gap(view::Live::Is(2.0))
                .ground(view::Live::By(fn() {
                  if active() { row_selected_bg() } else if btn.hovered() { row_hover_bg() } else { lg::clear }
                }))
              let _ = hrow(r, 6.0, fn(top : view::View) -> Unit {
                let _ = label_by(top, fn() { inst_sig.get().name }, size=14.0, weight=600).grow(view::Live::Is(1.0))
                let _ = lg::liquid_badge_node(top, fn() { "SPT \{inst_sig.get().spt_version}" }, tone=lg::LiquidTone::Success)
              })
              let _ = label_by(r, fn() { inst_sig.get().root }, size=11.5, ink=ink_muted)
            },
          )
        },
      )
    } else {
      let _ = hrow(body, 8.0, fn(u : view::View) -> Unit {
        let _ = lg::liquid_search_bar_node(
          u,
          path_field,
          placeholder="输入目录路径，如 C:\\Games\\SPT-4.1.6",
          label=fn() { "实例路径" },
          flat=true,
          edited=fn(p : String) -> Unit { s.probe_path_now(p) },
          submitted=fn(p : String) -> Unit { s.add_instance(p) },
        ).grow(view::Live::Is(1.0))
        let _ = glass_action(u, fn() { "导入" }, fn() { s.add_instance(path_field.text()) }, tint=c_cobalt, flat=true)
      })
    }
  })
}

pub fn role_popover_body(pop : view::View, s : model::Store) -> Unit {
  let _ = pop.gap(view::Live::Is(10.0))
  let _ = label(pop, "选择出战角色", size=14.5, weight=700)
  pop.each(
    fn() { s.characters.get() },
    fn(c : model::Character) -> String { c.username },
    fn(slot : view::View, c_sig : signals::Signal[model::Character]) -> Unit {
      let _ = headless::button(
        slot,
        fn() { c_sig.get().shown() },
        fn(_e) -> Unit {
          s.character.set(c_sig.untracked().username)
          s.role_open.set(false)
        },
        fn(r : view::View, btn : headless::Button) -> Unit {
          let active = fn() -> Bool { s.character.get() == c_sig.get().username }
          let _ = r
            .padding(view::Live::Is((10.0, 9.0, 10.0, 9.0)))
            .radius(view::Live::Is(10.0))
            .gap(view::Live::Is(2.0))
            .ground(view::Live::By(fn() {
              if active() { row_selected_bg() } else if btn.hovered() { row_hover_bg() } else { lg::clear }
            }))
          let _ = hrow(r, 6.0, fn(top : view::View) -> Unit {
            let _ = label_by(top, fn() { c_sig.get().shown() }, size=14.0, weight=600).grow(view::Live::Is(1.0))
            let _ = lg::liquid_badge_node(top, fn() { "\{c_sig.get().side} Lv.\{c_sig.get().level}" }, tone=lg::LiquidTone::Accent)
          })
          let _ = label_by(r, fn() { "\{c_sig.get().edition} · \{model::roubles_text(c_sig.get().roubles)}" }, size=12.0, ink=ink_muted)
        },
      )
    },
  )
}
