// Bunker UI helpers built 100% on AFK-surf/invar `lg` components:
// - ZERO hand-written `paint::Glass`
// - ZERO hand-written `inline_pill` buttons
// - Soft airy Light/Dark wallpaper matching invar's optical glass guidelines (zero cards, zero dividers)

import "lg"
import "view"

/// Deep accessible Monoid Cobalt & semantic accents (>= 4.5:1 contrast with white text on tinted glass).
pub let c_cobalt : Int64 = 0x0052B8FFL
pub let c_vermilion : Int64 = 0xB42318FFL
pub let c_green : Int64 = 0x30D158FFL
pub let c_amber : Int64 = 0xFF9F0AFFL
pub let c_red : Int64 = 0xFF3B30FFL

pub fn ink_primary() -> Int64 {
  lg::colors().content
}

pub fn ink_secondary() -> Int64 {
  lg::alpha(lg::colors().content, 0.72)
}

pub fn ink_muted() -> Int64 {
  lg::alpha(lg::colors().content, 0.54)
}

pub fn well_bg() -> Int64 {
  if lg::is_dark() { 0xFFFFFF0AL } else { 0xFFFFFF88L }
}

pub fn row_hover_bg() -> Int64 {
  if lg::is_dark() { 0xFFFFFF0FL } else { 0x0000000AL }
}

pub fn row_selected_bg() -> Int64 {
  if lg::is_dark() { 0x0088FF26L } else { 0x0088FF18L }
}

/// Soft airy wallpaper for Liquid Glass controls to refract cleanly (matches logi-dpi / invar).
pub fn bunker_backdrop(parent : view::View) -> Unit {
  let _ = parent.box(fn(paper : view::View) -> Unit {
    let _ = paper
      .over(view::Live::Is(true))
      .clips(view::Live::Is(true))
      .points(view::Live::Is(false))
      .ground(view::Live::By(fn() { if lg::is_dark() { 0x0A0B10FFL } else { 0xF3F4F7FFL } }))
    let blots : Array[(Double, Double, Double, Int64, Int64)] = [
      (-140.0, -180.0, 560.0, 0x7DD3FCFFL, 0x0E7490FFL),
      (640.0, -220.0, 620.0, 0xC4B5FDFFL, 0x6D28D9FFL),
      (340.0, 380.0, 620.0, 0x93C5FDFFL, 0x1D4ED8FFL),
    ]
    for bi = 0; bi < blots.length(); bi = bi + 1 {
      let b = blots[bi]
      let cx = b.0 + b.2 / 2.0
      let cy = b.1 + b.2 / 2.0
      let layers = 18
      for k = 0; k < layers; k = k + 1 {
        let t = k.to_double() / (layers - 1).to_double()
        let ld = b.2 * (1.76 - 1.60 * t)
        let a = 0.020 + 0.022 * t
        let light = b.3
        let dark = b.4
        let _ = paper.box(fn(c : view::View) -> Unit {
          let _ = c
            .over(view::Live::Is(true))
            .width(view::Live::Is(Some(ld)))
            .height(view::Live::Is(Some(ld)))
            .radius(view::Live::Is(ld / 2.0))
            .offset(view::Live::Is((cx - ld / 2.0, cy - ld / 2.0)))
            .ground(view::Live::By(fn() { lg::alpha(if lg::is_dark() { dark } else { light }, a) }))
        })
      }
    }
  })
}

/// Clean typographic section header (zero divider lines).
pub fn section_head(parent : view::View, title : String, detail~ : () -> String = fn() { "" }) -> Unit {
  let _ = parent.box(fn(r : view::View) -> Unit {
    let _ = r
      .row(view::Live::Is(true))
      .lies_along(view::Live::Is(view::Lies::Between))
      .lines_up(view::Live::Is(Some(view::Along::Middle)))
      .gap(view::Live::Is(12.0))
    let _ = r.box(fn(l : view::View) -> Unit {
      let _ = l
        .words(view::Live::Is(title), look=lg::words_at(13.0, weight=600))
        .ink(view::Live::By(ink_secondary))
    })
    r.show(fn() { detail() != "" }, fn(d : view::View) -> Unit {
      let _ = d
        .words(view::Live::By(detail), look=lg::words_at(12.0, weight=500))
        .ink(view::Live::By(ink_muted))
    })
  })
}

pub fn hrow(parent : view::View, gap : Double, body : (view::View) -> Unit) -> view::View {
  parent.box(fn(r : view::View) -> Unit {
    let _ = r
      .row(view::Live::Is(true))
      .gap(view::Live::Is(gap))
      .lines_up(view::Live::Is(Some(view::Along::Middle)))
    body(r)
  })
}

pub fn spacer(parent : view::View) -> Unit {
  let _ = parent.box(fn(s : view::View) -> Unit {
    let _ = s.grow(view::Live::Is(1.0))
  })
}

pub fn label(
  parent : view::View,
  text : String,
  size~ : Double = 14.0,
  weight~ : Int = 400,
  ink~ : () -> Int64 = ink_primary,
  wrap~ : Bool = false,
) -> view::View {
  parent.box(fn(w : view::View) -> Unit {
    let _ = w.words(view::Live::Is(text), look=lg::words_at(size, weight=weight, wrap=wrap)).ink(view::Live::By(ink))
  })
}

pub fn label_by(
  parent : view::View,
  text : () -> String,
  size~ : Double = 14.0,
  weight~ : Int = 400,
  ink~ : () -> Int64 = ink_primary,
  wrap~ : Bool = false,
) -> view::View {
  parent.box(fn(w : view::View) -> Unit {
    let _ = w.words(view::Live::By(text), look=lg::words_at(size, weight=weight, wrap=wrap)).ink(view::Live::By(ink))
  })
}

/// Compact real Liquid Glass action pill (`lg::liquid_chip_node` on canvas, `lg::liquid_button_node(flat=true)` in popovers).
pub fn glass_action(
  parent : view::View,
  text : () -> String,
  on_press : () -> Unit,
  tint~ : Int64 = lg::clear,
  danger~ : Bool = false,
  flat~ : Bool = false,
  disabled~ : () -> Bool = fn() { false },
) -> view::View {
  if flat {
    let t = if tint != lg::clear { tint } else if danger { c_vermilion } else { lg::clear }
    lg::liquid_button_node(parent, text, on_press, tint=t, flat=true, disabled=disabled)
  } else if tint != lg::clear {
    lg::liquid_chip_node(parent, text, on_press, selected=fn() { true }, toggleable=false, disabled=disabled)
  } else {
    lg::liquid_chip_node(parent, text, on_press, selected=fn() { false }, toggleable=false, disabled=disabled)
  }
}
