// macOS 27 Golden Gate (Apple HIG) design tokens & helpers built 100% on AFK-surf/invar `lg`.
// - Clean neutral content canvas (#FFFFFF light / #141416 dark) — zero rainbow blobs
// - Edge-to-edge sidebar (#F2F2F7 light / #1C1C1F dark) with crisp 1px structural edge
// - Standard Apple System Blue (#007AFF) primary accent + colorful semantic sidebar icons
// - ZERO hand-written glass, ZERO hand-written pill buttons

import "lg"
import "view"

/// Apple macOS 27 Golden Gate semantic accents.
pub let c_cobalt : Int64 = 0x007AFFFFL
pub let c_indigo : Int64 = 0x5856D6FFL
pub let c_green : Int64 = 0x28CD41FFL
pub let c_orange : Int64 = 0xFF9500FFL
pub let c_amber : Int64 = 0xFF9F0AFFL
pub let c_red : Int64 = 0xFF3B30FFL
pub let c_vermilion : Int64 = 0xD92D20FFL

pub fn canvas_bg() -> Int64 {
  if lg::is_dark() { 0x141416FFL } else { 0xFFFFFFFFL }
}

pub fn sidebar_bg() -> Int64 {
  if lg::is_dark() { 0x1C1C20FFL } else { 0xF3F3F7FFL }
}

pub fn sidebar_edge() -> Int64 {
  if lg::is_dark() { 0xFFFFFF14L } else { 0x00000012L }
}

pub fn surface_subtle() -> Int64 {
  if lg::is_dark() { 0x1E1E22FFL } else { 0xF5F5F7FFL }
}

pub fn well_bg() -> Int64 {
  if lg::is_dark() { 0x1B1B1FFFL } else { 0xF5F5F8FFL }
}

pub fn ink_primary() -> Int64 {
  lg::colors().content
}

pub fn ink_secondary() -> Int64 {
  lg::alpha(lg::colors().content, 0.68)
}

pub fn ink_muted() -> Int64 {
  lg::alpha(lg::colors().content, 0.48)
}

pub fn row_hover_bg() -> Int64 {
  if lg::is_dark() { 0xFFFFFF0CL } else { 0x00000008L }
}

pub fn row_selected_bg() -> Int64 {
  if lg::is_dark() { 0x0A84FF28L } else { 0x007AFF18L }
}

/// Clean typographic section header (zero divider hairlines).
pub fn section_head(parent : view::View, title : String, detail~ : () -> String = fn() { "" }) -> Unit {
  let _ = parent.box(fn(r : view::View) -> Unit {
    let _ = r
      .row(view::Live::Is(true))
      .lies_along(view::Live::Is(view::Lies::Between))
      .lines_up(view::Live::Is(Some(view::Along::Middle)))
      .gap(view::Live::Is(12.0))
    let _ = r.box(fn(l : view::View) -> Unit {
      let _ = l
        .words(view::Live::Is(title), look=lg::words_at(12.5, weight=600))
        .ink(view::Live::By(ink_muted))
    })
    r.show(fn() { detail() != "" }, fn(d : view::View) -> Unit {
      let _ = d
        .words(view::Live::By(detail), look=lg::words_at(12.0, weight=500))
        .ink(view::Live::By(ink_muted))
    })
  })
}

pub fn hrow(parent : view::View, gap : Double, body : (view::View) -> Unit) -> view::View {
  parent.box(fn(r : view::View) -> Unit {
    let _ = r
      .row(view::Live::Is(true))
      .gap(view::Live::Is(gap))
      .lines_up(view::Live::Is(Some(view::Along::Middle)))
    body(r)
  })
}

pub fn spacer(parent : view::View) -> Unit {
  let _ = parent.box(fn(s : view::View) -> Unit {
    let _ = s.grow(view::Live::Is(1.0))
  })
}

pub fn label(
  parent : view::View,
  text : String,
  size~ : Double = 14.0,
  weight~ : Int = 400,
  ink~ : () -> Int64 = ink_primary,
  wrap~ : Bool = false,
) -> view::View {
  parent.box(fn(w : view::View) -> Unit {
    let _ = w.words(view::Live::Is(text), look=lg::words_at(size, weight=weight, wrap=wrap)).ink(view::Live::By(ink))
  })
}

pub fn label_by(
  parent : view::View,
  text : () -> String,
  size~ : Double = 14.0,
  weight~ : Int = 400,
  ink~ : () -> Int64 = ink_primary,
  wrap~ : Bool = false,
) -> view::View {
  parent.box(fn(w : view::View) -> Unit {
    let _ = w.words(view::Live::By(text), look=lg::words_at(size, weight=weight, wrap=wrap)).ink(view::Live::By(ink))
  })
}

/// Official invar `lg` compact action (`lg::liquid_chip_node` on canvas, `lg::liquid_button_node(flat=true)` in popovers).
pub fn glass_action(
  parent : view::View,
  text : () -> String,
  on_press : () -> Unit,
  tint~ : Int64 = lg::clear,
  danger~ : Bool = false,
  flat~ : Bool = false,
  disabled~ : () -> Bool = fn() { false },
) -> view::View {
  if flat {
    let t = if tint != lg::clear { tint } else if danger { c_vermilion } else { lg::clear }
    lg::liquid_button_node(parent, text, on_press, tint=t, flat=true, disabled=disabled)
  } else if tint != lg::clear {
    lg::liquid_chip_node(parent, text, on_press, selected=fn() { true }, toggleable=false, disabled=disabled)
  } else {
    lg::liquid_chip_node(parent, text, on_press, selected=fn() { false }, toggleable=false, disabled=disabled)
  }
}
