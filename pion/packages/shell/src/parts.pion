// Shared pieces of the Bunker shell, all on invar's `lg` (Apple two-layer: solid Content Layer + floating glass
// chrome). Colours come only from `lg::surface()`; icons only from invar's `icons` package.

import "hostapi"
import "icons"
import "lg"
import "view"

/// Popovers: radius and padding chosen so a 32pt footer button (r=16) sits concentric in the corner (28 - 12 = 16).
pub let pop_r : Double = 28.0
pub let pop_pad : Double = 12.0
/// Top-bar pills: 36pt high, 2pt in, so the 32pt buttons inside keep a 36pt hit area and sit concentric (18 - 2 = 16).
pub let pill_h : Double = 36.0
/// Buttons inside popovers and cards.
pub let btn_h : Double = 32.0
/// Content cards: padding equal to the radius, so nothing inside ever sits in a corner arc.
pub let card_r : Double = 20.0
pub let card_pad : Double = 20.0
/// Below this the window shows the sidebar or a page, not both (SplitShell's breakpoint).
pub let narrow_w : Double = 760.0

pub fn ink() -> Int64 {
  lg::surface().ink
}

pub fn ink2() -> Int64 {
  lg::surface().ink_secondary
}

pub fn accent() -> Int64 {
  lg::surface().accent
}

/// Whether the window is too narrow for sidebar and page side by side.
pub fn is_narrow(v : view::View) -> Bool {
  let w = v.window_w()
  w > 0.0 && w < narrow_w
}

/// Body text in the Content Layer palette.
pub fn Label(
  parent : view::View,
  text~ : String = "",
  text_by? : () -> String,
  size~ : Double = 14.0,
  weight~ : Int = 400,
  wrap~ : Bool = false,
  lines~ : Int = 0,
  secondary~ : Bool = false,
  color_by? : () -> Int64,
  grow~ : Bool = false,
  pad_left~ : Double = 0.0,
) -> view::View {
  let t = match text_by {
    Some(f) => view::Live::By(f)
    None => view::Live::Is(text)
  }
  let c = match color_by {
    Some(f) => f
    None => if secondary { ink2 } else { ink }
  }
  parent.box(fn(w : view::View) -> Unit {
    let _ = w.words(t, look=lg::words_at(size, weight=weight, wrap=wrap || lines > 0, lines=lines)).ink(view::Live::By(c))
    if pad_left > 0.0 {
      let _ = w.margin(view::Live::Is((pad_left, 0.0, 0.0, 0.0)))
    }
    if grow || wrap {
      let _ = w.grow(view::Live::Is(1.0)).basis(view::Live::Is(Some(0.0))).min_width(view::Live::Is(Some(0.0)))
    }
  })
}

/// A flat (zero-glass) icon button for bars and cards: `lg::Button flat ghost` holding an invar icon.
pub fn IconAction(
  parent : view::View,
  icon~ : String,
  label~ : String,
  on_press~ : () -> Unit,
  disabled_by? : () -> Bool,
) -> view::View {
  let dis = match disabled_by {
    Some(f) => f
    None => fn() { false }
  }
  <lg::Button in={parent} flat ghost height={32.0} pad_x={10.0} label={label} on_press={on_press} disabled_by={dis}>
    <icons::Icon name={icon} size={16.0} color_by=>{ink()} />
  </lg::Button>
}

/// The window's own controls (no system title bar): minimize and close, in their own floating pill.
pub fn WindowPills(parent : view::View) -> view::View {
  <lg::BarPillGroup in={parent} height={pill_h} label="窗口">
    <IconAction icon="minus" label="最小化" on_press=>{hostapi::window_act(1)} />
    <IconAction icon="close" label="关闭" on_press=>{hostapi::window_act(3)} />
  </lg::BarPillGroup>
}

/// A page's leading bar slot: a back island when the window is narrow, then the page's title (the window's drag row).
pub fn PageTitle(parent : view::View, title~ : String, on_back~ : () -> Unit) -> view::View {
  parent.show(fn() { is_narrow(parent) }, at_once=true, fn(b : view::View) -> Unit {
    <lg::BackButton in={b} label="Bunker" on_press={on_back} />
  })
  let _ = parent.box(fn(t : view::View) -> Unit {
    let _ = t
      .moves_window(view::Live::Is(true))
      .row(view::Live::Is(true))
      .height(view::Live::Is(Some(36.0)))
      .min_width(view::Live::Is(Some(160.0)))
      .lines_up(view::Live::Is(Some(view::Along::Middle)))
      .padding(view::Live::Is((6.0, 0.0, 6.0, 0.0)))
    <Label in={t} text={title} size={20.0} weight={700} />
  })
  parent
}

/// A hairline between rows of a section, inset from the leading edge as Apple's grouped lists are.
pub fn Divider(parent : view::View, inset~ : Double = 20.0) -> view::View {
  parent.box(fn(d : view::View) -> Unit {
    let _ = d.padding(view::Live::Is((inset, 0.0, 0.0, 0.0)))
    let _ = d.box(fn(line : view::View) -> Unit {
      let _ = line.height(view::Live::Is(Some(lg::hairline_w))).ground(view::Live::By(fn() { lg::surface().separator }))
    })
  })
}

/// A row of a section: leading content and trailing controls, padded clear of the card's corner arcs.
pub fn SectionRow(parent : view::View, pad_y~ : Double = 12.0, min_h~ : Double = 52.0, children~ : (view::View) -> Unit) -> view::View {
  parent.box(fn(r : view::View) -> Unit {
    let _ = r
      .row(view::Live::Is(true))
      .lines_up(view::Live::Is(Some(view::Along::Middle)))
      .gap(view::Live::Is(12.0))
      .min_height(view::Live::Is(Some(min_h)))
      .padding(view::Live::Is((card_pad, pad_y, card_pad, pad_y)))
    children(r)
  })
}

/// A pair of words: a secondary name and its value, on one row.
pub fn KeyValue(parent : view::View, key~ : String, value_by~ : () -> String) -> view::View {
  <SectionRow in={parent} pad_y={12.0} min_h={44.0}>
    <Label text={key} size={13.5} secondary grow />
    <Label text_by={value_by} size={13.5} weight={600} />
  </SectionRow>
}
