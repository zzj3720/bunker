// Bunker Liquid Glass design primitives modeled directly on AFK-surf/invar (`packages/lg` + `lg_pages/library.pion`).
// - 18-layer smooth atmospheric wallpaper (dark obsidian / light warm stone)
// - Zero content cards: content sits openly on the wallpaper with hairline section headers
// - Real `lg::*` Liquid Glass controls floating cleanly with zero glass-on-glass

import "headless"
import "lg"
import "motion"
import "paint"
import "view"

/// Deep accessible Monoid Cobalt & Crimson (>= 4.5:1 contrast with white text through translucent glass).
pub let c_cobalt : Int64 = 0x0052B8FFL
pub let c_vermilion : Int64 = 0xA62908FFL
pub let c_green : Int64 = 0x30D158FFL
pub let c_amber : Int64 = 0xFF9F0AFFL
pub let c_red : Int64 = 0xFF5A52FFL

pub fn ink_primary() -> Int64 {
  lg::colors().content
}

pub fn ink_secondary() -> Int64 {
  lg::alpha(lg::colors().content, 0.72)
}

pub fn ink_muted() -> Int64 {
  lg::alpha(lg::colors().content, 0.54)
}

pub fn hairline_ink() -> Int64 {
  lg::alpha(lg::colors().content, 0.12)
}

pub fn well_bg() -> Int64 {
  if lg::is_dark() { 0x00000044L } else { 0xFFFFFF78L }
}

pub fn row_hover_bg() -> Int64 {
  if lg::is_dark() { 0xFFFFFF0FL } else { 0x0000000AL }
}

pub fn row_selected_bg() -> Int64 {
  if lg::is_dark() { 0x0088FF26L } else { 0x0088FF18L }
}

pub fn capsule_glass() -> paint::Glass {
  let d = lg::is_dark()
  paint::Glass::liquid(
    blur=2.1,
    tint=if d { 0x202020FFL } else { 0xFDFCFD67L },
    solid=if d { 0x1E1F24FFL } else { 0xFAFAFAFFL },
    saturation=1.0,
    rim=0.6,
    bezel=18.0,
    refraction=24.0,
    chroma=0.0,
    merge=0.0,
    adaptive=false,
  )
}

/// 18-layer smooth atmospheric wallpaper matching `invar/packages/lg_pages/src/pages.pion`.
/// Gives every floating Liquid Glass control clean, banding-free colour fields to refract.
pub fn bunker_backdrop(parent : view::View) -> Unit {
  let _ = parent.box(fn(paper : view::View) -> Unit {
    let _ = paper
      .over(view::Live::Is(true))
      .clips(view::Live::Is(true))
      .points(view::Live::Is(false))
      .ground(view::Live::By(fn() { if lg::is_dark() { 0x090A0EFFL } else { 0xF4F1EAFFL } }))
    let blots : Array[(Double, Double, Double, Int64, Int64)] = [
      // Top-left: Deep Teal
      (-140.0, -140.0, 520.0, 0x7ED8C8FFL, 0x0E5A58FFL),
      // Top-right: Deep Cobalt / Indigo
      (680.0, -160.0, 560.0, 0x8CC4FAFFL, 0x1D4ED8FFL),
      // Bottom-right: Subtle Slate Violet
      (740.0, 400.0, 520.0, 0xC4B5FDFFL, 0x3B2A7AFFL),
    ]
    let mut bi = 0
    while bi < blots.length() {
      let b = blots[bi]
      let cx = b.0 + b.2 / 2.0
      let cy = b.1 + b.2 / 2.0
      let d = b.2
      let light_col = b.3
      let dark_col = b.4
      let layers = 18
      let mut k = 0
      while k < layers {
        let t = k.to_double() / (layers - 1).to_double()
        let ld = d * (1.76 - 1.60 * t)
        let base_a = 0.016 + 0.016 * t
        let _ = paper.box(fn(c : view::View) -> Unit {
          let _ = c
            .over(view::Live::Is(true))
            .width(view::Live::Is(Some(ld)))
            .height(view::Live::Is(Some(ld)))
            .radius(view::Live::Is(ld / 2.0))
            .offset(view::Live::Is((cx - ld / 2.0, cy - ld / 2.0)))
            .ground(view::Live::By(fn() {
              lg::alpha(if lg::is_dark() { dark_col } else { light_col }, base_a)
            }))
        })
        k += 1
      }
      bi += 1
    }
  })
}

/// AFK-style subtle section header with trailing hairline rule (directly on wallpaper, zero card chrome).
pub fn section_head(parent : view::View, title : String, detail~ : () -> String = fn() { "" }) -> Unit {
  let _ = parent.box(fn(hdr : view::View) -> Unit {
    let _ = hdr.gap(view::Live::Is(6.0))
    let _ = hdr.box(fn(r : view::View) -> Unit {
      let _ = r
        .row(view::Live::Is(true))
        .lies_along(view::Live::Is(view::Lies::Between))
        .lines_up(view::Live::Is(Some(view::Along::Middle)))
        .gap(view::Live::Is(12.0))
      let _ = r.box(fn(l : view::View) -> Unit {
        let _ = l
          .words(view::Live::Is(title), look=lg::words_at(12.0, weight=600))
          .ink(view::Live::By(ink_secondary))
      })
      r.show(fn() { detail() != "" }, fn(d : view::View) -> Unit {
        let _ = d
          .words(view::Live::By(detail), look=lg::words_at(12.0, weight=500))
          .ink(view::Live::By(ink_muted))
      })
    })
    divider(hdr)
  })
}

pub fn hrow(parent : view::View, gap : Double, body : (view::View) -> Unit) -> view::View {
  parent.box(fn(r : view::View) -> Unit {
    let _ = r
      .row(view::Live::Is(true))
      .gap(view::Live::Is(gap))
      .lines_up(view::Live::Is(Some(view::Along::Middle)))
    body(r)
  })
}

pub fn spacer(parent : view::View) -> Unit {
  let _ = parent.box(fn(s : view::View) -> Unit {
    let _ = s.grow(view::Live::Is(1.0))
  })
}

pub fn divider(parent : view::View) -> Unit {
  let _ = parent.box(fn(d : view::View) -> Unit {
    let _ = d.height(view::Live::Is(Some(1.0))).ground(view::Live::By(hairline_ink))
  })
}

pub fn label(
  parent : view::View,
  text : String,
  size~ : Double = 14.0,
  weight~ : Int = 400,
  ink~ : () -> Int64 = ink_primary,
  wrap~ : Bool = false,
) -> view::View {
  parent.box(fn(w : view::View) -> Unit {
    let _ = w.words(view::Live::Is(text), look=lg::words_at(size, weight=weight, wrap=wrap)).ink(view::Live::By(ink))
  })
}

pub fn label_by(
  parent : view::View,
  text : () -> String,
  size~ : Double = 14.0,
  weight~ : Int = 400,
  ink~ : () -> Int64 = ink_primary,
  wrap~ : Bool = false,
) -> view::View {
  parent.box(fn(w : view::View) -> Unit {
    let _ = w.words(view::Live::By(text), look=lg::words_at(size, weight=weight, wrap=wrap)).ink(view::Live::By(ink))
  })
}

/// Compact pill action for dense inline rows and inside glass popovers (zero glass-on-glass).
pub fn inline_pill(
  parent : view::View,
  text : () -> String,
  on_press : () -> Unit,
  tint~ : Int64 = lg::clear,
  danger~ : Bool = false,
  disabled~ : () -> Bool = fn() { false },
) -> view::View {
  headless::button(parent, text, fn(_e) -> Unit { on_press() }, disabled=disabled, fn(b : view::View, btn : headless::Button) -> Unit {
    let hover_t = motion::hover_fade(b, fn() { btn.hovered() && !btn.disabled() })
    let press_t = motion::hover_fade(b, fn() { btn.pressed() && !btn.disabled() }, duration_ms=motion::pointer_tap_ms)
    let _ = b
      .row(view::Live::Is(true))
      .lines_up(view::Live::Is(Some(view::Along::Middle)))
      .lies_along(view::Live::Is(view::Lies::Middle))
      .height(view::Live::Is(Some(30.0)))
      .shrink(view::Live::Is(0.0))
      .padding(view::Live::Is((12.0, 0.0, 12.0, 0.0)))
      .radius(view::Live::Is(15.0))
      .ground(view::Live::By(fn() {
        let base = if tint != lg::clear {
          tint
        } else if danger {
          if lg::is_dark() { 0xFF453A26L } else { 0xD92D2018L }
        } else if lg::is_dark() {
          0xFFFFFF14L
        } else {
          0x0000000DL
        }
        let hv = hover_t()
        let pv = press_t()
        let ov = if lg::is_dark() { 0xFFFFFF20L } else { 0x00000014L }
        let h1 = if hv > 0.001 { lg::over(base, lg::alpha(ov, hv)) } else { base }
        if pv > 0.001 { lg::over(h1, lg::alpha(ov, pv)) } else { h1 }
      }))
      .alpha(view::Live::By(fn() { if btn.disabled() { 0.45 } else { 1.0 } }))
    let _ = b.box(fn(w : view::View) -> Unit {
      let _ = w
        .words(view::Live::By(text), look=lg::words_at(12.5, weight=500))
        .ink(view::Live::By(fn() {
          if tint != lg::clear {
            lg::white
          } else if danger {
            if lg::is_dark() { 0xFF8A84FFL } else { 0xB42318FFL }
          } else {
            ink_primary()
          }
        }))
    })
  })
}

pub fn chevron_down_icon(parent : view::View, ink : () -> Int64) -> Unit {
  let _ = parent.box(fn(ic : view::View) -> Unit {
    let _ = ic
      .width(view::Live::Is(Some(12.0)))
      .height(view::Live::Is(Some(12.0)))
      .shrink(view::Live::Is(0.0))
      .shapes(view::Live::By(fn() {
        let pts : Array[Double] = [2.5, 4.5, 6.0, 8.0, 9.5, 4.5]
        [paint::shape_of([(pts, false)], stroke=ink(), width=1.6)]
      }))
  })
}

pub fn sun_moon_icon(parent : view::View, ink : () -> Int64) -> Unit {
  let _ = parent.box(fn(ic : view::View) -> Unit {
    let _ = ic
      .width(view::Live::Is(Some(16.0)))
      .height(view::Live::Is(Some(16.0)))
      .shrink(view::Live::Is(0.0))
      .shapes(view::Live::By(fn() {
        let pts : Array[Double] = [10.5, 3.0, 7.0, 4.2, 5.2, 7.5, 6.4, 11.2, 9.8, 12.8, 12.8, 11.5, 9.8, 11.2, 8.2, 8.2, 9.2, 4.8]
        [paint::shape_of([(pts, true)], stroke=ink(), width=1.5)]
      }))
  })
}
